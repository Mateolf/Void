        local head = char:FindFirstChild("Head")
        if not head then return nil end
        local highlight = Instance.new("Highlight")
        highlight.Name = "__VoidHub_Highlight"
        highlight.Adornee = char
        highlight.FillColor = PlayerESP.FillColor
        highlight.OutlineColor = PlayerESP.OutlineColor
        highlight.FillTransparency = PlayerESP.FillTransparency
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = char
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "__VoidHub_Billboard"
        billboard.Adornee = head
        billboard.Size = UDim2.fromOffset(180, 40)
        billboard.StudsOffset = Vector3.new(0, 2.4, 0)
        billboard.AlwaysOnTop = true
        billboard.MaxDistance = PlayerESP.MaxDistance
        billboard.Parent = char
        local nameLbl = Instance.new("TextLabel")
        nameLbl.BackgroundTransparency = 1
        nameLbl.Size = UDim2.new(1, 0, 0.55, 0)
        nameLbl.Font = Enum.Font.Code
        nameLbl.TextSize = 14
        nameLbl.TextColor3 = Color3.new(1, 1, 1)
        nameLbl.TextStrokeTransparency = 0
        nameLbl.Text = plr.Name
        nameLbl.Parent = billboard
        local distLbl = Instance.new("TextLabel")
        distLbl.BackgroundTransparency = 1
        distLbl.Position = UDim2.new(0, 0, 0.55, 0)
        distLbl.Size = UDim2.new(1, 0, 0.45, 0)
        distLbl.Font = Enum.Font.Code
        distLbl.TextSize = 12
        distLbl.TextColor3 = Color3.fromRGB(200, 200, 200)
        distLbl.TextStrokeTransparency = 0
        distLbl.Text = ""
        distLbl.Parent = billboard
        return { highlight = highlight, billboard = billboard, nameLbl = nameLbl, distLbl = distLbl }
    end

    local function playerEspStep()
        local cam = workspace.CurrentCamera
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                local skip = false
                if PlayerESP.TeamCheck and plr.Team == LocalPlayer.Team then skip = true end
                if hrp and cam then
                    if (cam.CFrame.Position - hrp.Position).Magnitude > PlayerESP.MaxDistance then
                        skip = true
                    end
                end
                if skip then
                    local tag = PlayerESP.Tags[plr]
                    if tag then
                        if tag.highlight then tag.highlight.Enabled = false end
                        if tag.billboard then tag.billboard.Enabled = false end
                    end
                else
                    local tag = PlayerESP.Tags[plr]
                    if not tag or not tag.highlight or not tag.highlight.Parent then
                        tag = makePlayerTag(plr)
                        PlayerESP.Tags[plr] = tag
                    end
                    if tag then
                        if tag.highlight then
                            tag.highlight.Enabled = true
                            tag.highlight.FillColor = PlayerESP.FillColor
                            tag.highlight.OutlineColor = PlayerESP.OutlineColor
                            tag.highlight.FillTransparency = PlayerESP.FillTransparency
                        end
                        if tag.billboard then
                            tag.billboard.Enabled = true
                            tag.billboard.MaxDistance = PlayerESP.MaxDistance
                        end
                        if tag.nameLbl then
                            tag.nameLbl.Visible = PlayerESP.ShowName
                            tag.nameLbl.Text = plr.Name
                            if hum and PlayerESP.ShowHealth then
                                tag.nameLbl.Text = string.format("%s  [%d/%d]",
                                    plr.Name, math.floor(hum.Health), math.floor(hum.MaxHealth))
                            end
                        end
                        if tag.distLbl and hrp and cam then
                            tag.distLbl.Visible = PlayerESP.ShowDistance
                            tag.distLbl.Text = string.format("%d studs",
                                (cam.CFrame.Position - hrp.Position).Magnitude)
                        end
                    end
                end
            end
        end
        for plr, tag in pairs(PlayerESP.Tags) do
            if not plr.Parent or not plr.Character then
                if tag.highlight then pcall(function() tag.highlight:Destroy() end) end
                if tag.billboard then pcall(function() tag.billboard:Destroy() end) end
                PlayerESP.Tags[plr] = nil
            end
        end
    end

    HUB.sectionHeader(playerEspTab.page, "ESP Controls")
    HUB.makeToggle(playerEspTab.page, "Enable Player ESP", false, function(v)
        PlayerESP.Enabled = v
        if not v then destroyPlayerTags() end
        HUB.setStatus("Player ESP " .. (v and "enabled" or "disabled") .. ".")
    end)
    HUB.makeToggle(playerEspTab.page, "Show Name",     true, function(v) PlayerESP.ShowName = v end)
    HUB.makeToggle(playerEspTab.page, "Show Distance", true, function(v) PlayerESP.ShowDistance = v end)
    HUB.makeToggle(playerEspTab.page, "Show Health",   true, function(v) PlayerESP.ShowHealth = v end)
    HUB.makeToggle(playerEspTab.page, "Team Check",    false, function(v) PlayerESP.TeamCheck = v end)
    HUB.sectionHeader(playerEspTab.page, "Appearance")
    HUB.makeSlider(playerEspTab.page, "Max Distance", 50, 5000, 1000, function(v)
        PlayerESP.MaxDistance = v
    end)
    HUB.makeSlider(playerEspTab.page, "Fill Transparency", 0, 1, 0.4, function(v)
        PlayerESP.FillTransparency = v
    end)
    HUB.makeButton(playerEspTab.page, "Randomize Fill Color", function()
        PlayerESP.FillColor = Color3.fromRGB(
            math.random(80, 255), math.random(80, 255), math.random(80, 255))
    end)
    HUB.makeButton(playerEspTab.page, "Randomize Outline Color", function()
        PlayerESP.OutlineColor = Color3.fromRGB(
            math.random(120, 255), math.random(120, 255), math.random(120, 255))
    end)

    bind(RunService.Heartbeat, function()
        if HUB.__saving then return end
        if PlayerESP.Enabled then
            local ok, err = pcall(playerEspStep)
            if not ok then
                PlayerESP.Enabled = false
                HUB.setStatus("Player ESP error: " .. tostring(err), "error")
            end
        end
    end)
end

