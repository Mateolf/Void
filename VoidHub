    end)

    HUB.sectionHeader(playerTab.page, "Movement")
    HUB.makeSlider(playerTab.page, "WalkSpeed", 8, 300, 16, function(v)
        PlayerState.SpeedOverride.value = v
        if PlayerState.SpeedOverride.enabled then
            local hum = getHum()
            if hum then hum.WalkSpeed = v end
        end
    end)
    HUB.makeToggle(playerTab.page, "Enable Speed Override", false, function(v)
        PlayerState.SpeedOverride.enabled = v
        if v then
            task.spawn(function()
                while PlayerState.SpeedOverride.enabled do
                    local hum = getHum()
                    if hum and not HUB.__saving then
                        hum.WalkSpeed = PlayerState.SpeedOverride.value
                    end
                    task.wait(0.25)
                end
            end)
        end
        HUB.setStatus("Speed override " .. (v and "on" or "off") .. ".")
    end)
    HUB.makeSlider(playerTab.page, "JumpPower", 50, 500, 50, function(v)
        PlayerState.JumpOverride.value = v
        if PlayerState.JumpOverride.enabled then
            local hum = getHum()
            if hum then pcall(function()
                hum.UseJumpPower = true
                hum.JumpPower = v
            end) end
        end
    end)
    HUB.makeToggle(playerTab.page, "Enable Jump Override", false, function(v)
        PlayerState.JumpOverride.enabled = v
        if v then
            task.spawn(function()
                while PlayerState.JumpOverride.enabled do
                    local hum = getHum()
                    if hum and not HUB.__saving then pcall(function()
                        hum.UseJumpPower = true
                        hum.JumpPower = PlayerState.JumpOverride.value
                    end) end
                    task.wait(0.25)
                end
            end)
        end
    end)
    HUB.makeSlider(playerTab.page, "Gravity", 0, 500, 196.2, function(v)
        PlayerState.GravityOverride.value = v
        if PlayerState.GravityOverride.enabled then workspace.Gravity = v end
    end)
    HUB.makeToggle(playerTab.page, "Enable Gravity Override", false, function(v)
        PlayerState.GravityOverride.enabled = v
        workspace.Gravity = v and PlayerState.GravityOverride.value or 196.2
    end)

    HUB.makeToggle(playerTab.page, "Noclip", false, function(v)
        PlayerState.Noclip = v
        HUB.setStatus("Noclip " .. (v and "on" or "off") .. ".")
    end)
    local noclipAccum = 0
    bind(RunService.Stepped, function(_, dt)
        if HUB.__saving then return end
        if not PlayerState.Noclip then return end
        noclipAccum += dt
        if noclipAccum < 0.1 then return end
        noclipAccum = 0
        local char = getChar()
        if not char then return end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end)

    local function stopFly()
        PlayerState.Fly = false
        if PlayerState.FlyConn then
            pcall(function() PlayerState.FlyConn:Disconnect() end)
            PlayerState.FlyConn = nil
        end
        local hrp = getHRP()
        if hrp then
            for _, n in ipairs({"__VoidHub_FlyVelocity", "__VoidHub_FlyGyro"}) do
                local obj = hrp:FindFirstChild(n)
                if obj then pcall(function() obj:Destroy() end) end
            end
        end
    end
    HUB.stopFly = stopFly

    local function startFly()
        local hrp, hum = getHRP(), getHum()
        if not hrp or not hum then return end
        local bv = Instance.new("BodyVelocity")
        bv.Name = "__VoidHub_FlyVelocity"
        bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        bv.Velocity = Vector3.zero
        bv.Parent = hrp
        local bg = Instance.new("BodyGyro")
        bg.Name = "__VoidHub_FlyGyro"
        bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
        bg.P = 1000; bg.D = 50
        bg.Parent = hrp
        PlayerState.Fly = true
        PlayerState.FlyConn = RunService.RenderStepped:Connect(function()
            if not PlayerState.Fly then return end
            local root = getHRP()
            if not root then return end
            local cam = workspace.CurrentCamera
            local moveDir = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0, 1, 0) end
            if moveDir.Magnitude < 0.05 then
                local h = getHum()
                if h and h.MoveDirection.Magnitude > 0.05 then moveDir = h.MoveDirection end
            end
            bv.Velocity = moveDir.Magnitude > 0 and (moveDir.Unit * PlayerState.FlySpeed) or Vector3.zero
            bg.CFrame = cam.CFrame
        end)
    end

    HUB.makeSlider(playerTab.page, "Fly Speed", 10, 300, 60, function(v)
        PlayerState.FlySpeed = v
    end)
    HUB.makeToggle(playerTab.page, "Fly (camera-relative)", false, function(v)
        if v then
            startFly()
            HUB.setStatus("Fly on. " .. (isMobile and "Use the joystick to steer."
                or "WASD + Space/Shift to move."), "success")
        else
            stopFly()
            HUB.setStatus("Fly off.")
        end
    end)

    local function stopSwim()
        PlayerState.Swim = false
        if PlayerState.SwimConn then
            pcall(function() PlayerState.SwimConn:Disconnect() end)
            PlayerState.SwimConn = nil
        end
        local hrp = getHRP()
        if hrp then
            for _, n in ipairs({"__VoidHub_SwimForce", "__VoidHub_SwimVelocity"}) do
                local obj = hrp:FindFirstChild(n)
                if obj then pcall(function() obj:Destroy() end) end
            end
        end
        local hum = getHum()
        if hum then
            pcall(function()
                hum:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)
            end)
        end
    end
    HUB.stopSwim = stopSwim

    local function startSwim()
        local hrp, hum = getHRP(), getHum()
        if not hrp or not hum then return end
        local bf = Instance.new("BodyForce")
        bf.Name = "__VoidHub_SwimForce"
        bf.Force = Vector3.new(0, workspace.Gravity * hrp.AssemblyMass, 0)
        bf.Parent = hrp
        local bv = Instance.new("BodyVelocity")
        bv.Name = "__VoidHub_SwimVelocity"
        bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        bv.Velocity = Vector3.zero
        bv.Parent = hrp
        pcall(function()
            hum:SetStateEnabled(Enum.HumanoidStateType.Swimming, true)
        end)
        PlayerState.Swim = true
        PlayerState.SwimConn = RunService.RenderStepped:Connect(function()
            if not PlayerState.Swim then return end
            local root = getHRP()
            local h = getHum()
            if not root or not h or not bv.Parent then return end
            local speed = PlayerState.SwimSpeed or 14
            local dir = h.MoveDirection
            local velocity = Vector3.new(dir.X * speed, 0, dir.Z * speed)
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                velocity = velocity + Vector3.new(0, speed * 0.65, 0)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
                or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then
                velocity = velocity - Vector3.new(0, speed * 0.65, 0)
            end
            if isMobile then
                local cam = workspace.CurrentCamera
                local pitch = cam and cam.CFrame.LookVector.Y or 0
                if math.abs(pitch) > 0.2 then
                    velocity = velocity + Vector3.new(0, pitch * speed * 0.75, 0)
                end
            end
            bv.Velocity = velocity
        end)
    end

    HUB.makeSlider(playerTab.page, "Swim Speed", 5, 60, 14, function(v)
        PlayerState.SwimSpeed = v
    end)
    HUB.makeToggle(playerTab.page, "Swim (float through air)", false, function(v)
        if v then
            startSwim()
            HUB.setStatus("Swim on. " .. (isMobile
                and "Joystick to move, look up/down to rise/sink."
