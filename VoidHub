-- CORE HELPERS
---------------------------------------------------------------------------
local Connections = {}
local function bind(signal, fn)
    local c = signal:Connect(fn)
    Connections[#Connections + 1] = c
    return c
end

local function new(class, props, children)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then inst[k] = v end
    end
    for _, ch in ipairs(children or {}) do ch.Parent = inst end
    if props and props.Parent then inst.Parent = props.Parent end
    return inst
end

local statusLabel
local function setStatus(text, kind, silent)
    text = tostring(text)
    if statusLabel then
        statusLabel.Text = text
        statusLabel.TextColor3 = (kind == "error" and HUB.Theme.Error)
            or (kind == "success" and HUB.Theme.Success)
            or HUB.Theme.SubText
    end
    if not silent then
        print(("[%s] %s"):format(HUB_NAME, text))
    end
end

local function notify(title, text, duration)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title, Text = text, Duration = duration or 5,
        })
    end)
end

HUB.setStatus = setStatus
HUB.notify = notify

