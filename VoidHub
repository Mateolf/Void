---------------------------------------------------------------------------
-- DRAGGING + MINIMIZE + UNLOAD
---------------------------------------------------------------------------
local minimized = false
local toggleButton

do
    local main = HUB.main
    local shadow = HUB.shadow
    local topBar

    for _, c in ipairs(main:GetChildren()) do
        if c.Name == "TopBar" then topBar = c; break end
    end

    if topBar then
        local dragging, dragInput, dragStart, startPos
        local function update(input)
            local d = input.Position - dragStart
            main.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
        bind(topBar.InputBegan, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging, dragStart, startPos = true, input.Position, main.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)
        bind(topBar.InputChanged, function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)
        bind(UserInputService.InputChanged, function(input)
            if input == dragInput and dragging then update(input) end
        end)
    end

    local VH_PURPLE = Color3.fromRGB(155, 100, 220)
    local VH_BLACK  = Color3.fromRGB(18, 16, 22)

    toggleButton = new("TextButton", {
        Name = "FloatingToggle", Parent = HUB.screenGui,
        Position = UDim2.new(1, -(FLOAT_BTN_SIZE + 14), 0, 14),
        Size = UDim2.fromOffset(FLOAT_BTN_SIZE, FLOAT_BTN_SIZE),
        BackgroundColor3 = HUB.Theme.Surface,
        BackgroundTransparency = 0.05,
        Text = "V.H",
        TextColor3 = VH_PURPLE,
        Font = Enum.Font.GothamBold,
        TextSize = isMobile and 14 or 17,
        Visible = false, AutoButtonColor = false, BorderSizePixel = 0,
    }, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })

    local toggleStroke = new("UIStroke", { Parent = toggleButton })
    toggleStroke.Thickness = 1.5
    toggleStroke.Color = Color3.fromRGB(255, 255, 255)
    toggleStroke.Transparency = 0.55
    toggleStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

    task.spawn(function()
        local toPurple = false
        while toggleButton and toggleButton.Parent do
            toPurple = not toPurple
            local target = toPurple and VH_PURPLE or VH_BLACK
            TweenService:Create(toggleButton,
                TweenInfo.new(1.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
                { TextColor3 = target }):Play()
            task.wait(1.5)
        end
    end)

    local function setMinimized(state)
        minimized = state
        main.Visible = not state
        shadow.Visible = not state
        toggleButton.Visible = state
        local Music = HUB.Music
        if Music and Music.Sound then
            if Music.KeepPlayingWhenHidden then return end
            if state then
                Music.WasPlaying = Music.Playing
                if Music.Playing and HUB.setPlaying then
                    HUB.setPlaying(false)
                    if HUB.lcdStatus then
                        HUB.lcdStatus.Text = "PAUSED (hub hidden)"
                    end
                end
            else
                if Music.WasPlaying and HUB.setPlaying then
                    Music.WasPlaying = false
                    HUB.setPlaying(true)
                end
            end
        end
    end
    HUB.setMinimized = setMinimized

    do
        local dragging, dragInput, dragStart, startPos = false, nil, nil, nil
        local dragMoved = false
        local function update(input)
            local d = input.Position - dragStart
            if math.abs(d.X) > 3 or math.abs(d.Y) > 3 then dragMoved = true end
            toggleButton.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
        bind(toggleButton.InputBegan, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging, dragStart, startPos = true, input.Position, toggleButton.Position
                dragMoved = false
            end
        end)
        bind(toggleButton.InputChanged, function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)
        bind(UserInputService.InputChanged, function(input)
            if input == dragInput and dragging then update(input) end
        end)
        bind(UserInputService.InputEnded, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                local wasDragging = dragging
                dragging = false
                if wasDragging and not dragMoved then setMinimized(false) end
            end
        end)
    end

    local unload

    bind(HUB.minBtn.MouseButton1Click,   function() setMinimized(true) end)
    bind(HUB.closeBtn.MouseButton1Click, function() unload() end)

    bind(UserInputService.InputBegan, function(input, _gp)
        if input.KeyCode ~= TOGGLE_KEY then return end
        if ENV.__VoidHub_Listening then return end
        if ENV.__VoidHub_JustRebound == input.KeyCode then
            ENV.__VoidHub_JustRebound = nil
            return
        end
        local focused = UserInputService:GetFocusedTextBox()
        if focused and focused:IsFocused() then return end
        setMinimized(not minimized)
    end)

    unload = function()
        if ENV.__VoidHub and ENV.__VoidHub._unloaded then return end
        if ENV.__VoidHub then ENV.__VoidHub._unloaded = true end

        pcall(function()
            local Music = HUB.Music
            if Music and Music.Sound then
                Music.Sound:Stop()
                Music.Sound:Destroy()
                Music.Sound = nil
            end
            if Music then
                Music.Playing    = false
                Music.WasPlaying = false
            end
        end)

        local PlayerState = HUB.PlayerState
        if PlayerState then
            pcall(function() if HUB.stopFly then HUB.stopFly() end end)
            pcall(function() if HUB.stopSwim then HUB.stopSwim() end end)
            PlayerState.Noclip     = false
            PlayerState.Invisible  = false
            PlayerState.GodMode    = false
            PlayerState.InfiniteJump = false
            PlayerState.AntiAfk    = false
            pcall(function() workspace.Gravity = 196.2 end)
            local hum = HUB.getHum and HUB.getHum()
            if hum then
                pcall(function()
                    hum.WalkSpeed = 16
                    hum.UseJumpPower = true
                    hum.JumpPower = 50
                end)
            end
        end

        local FarmState = ENV.__VoidHub_FarmState
        if FarmState then FarmState.AutoWinRunning = false end

        local Combat = ENV.__VoidHub_Combat
        if Combat then
            Combat.AutoTarget = false
            Combat.AutoFire   = false
            if Combat.Indicator then
                pcall(function() Combat.Indicator:Destroy() end)
                Combat.Indicator = nil
            end
        end

        local ItemFarm = ENV.__VoidHub_ItemFarm
        if ItemFarm then ItemFarm.AutoCollecting = false end

        local Forest = ENV.__VoidHub_Forest
        if Forest then
            if Forest.Finisher and type(Forest.Finisher.Stop) == "function" then
                pcall(function() Forest.Finisher:Stop() end)
            end
            Forest.Running = false
        end

        if HUB.destroyPlayerTags then pcall(HUB.destroyPlayerTags) end

        for _, c in ipairs(Connections) do
            pcall(function() c:Disconnect() end)
        end
        table.clear(Connections)

        pcall(function() HUB.screenGui:Destroy() end)

        ENV.__VoidHub = nil
        print(("[%s] unloaded."):format(HUB_NAME))
    end

    ENV.__VoidHub = { Unload = unload, Version = HUB_VERSION, _unloaded = false }
end

