do
    local scriptsTab = HUB.createTab("scripts", "Scripts")

    -- ─── Warning banner ─────────────────────────────────────────────
    do
        local warn = new("Frame", { Parent = scriptsTab.page,
            LayoutOrder = HUB.nOrder(), Size = UDim2.new(1, 0, 0, 64),
            BackgroundColor3 = Color3.fromRGB(60, 18, 18), BorderSizePixel = 0 },
