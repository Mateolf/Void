        local c = Theme[key]
        if c == nil then return end
        if transform then c = transform(c) end
        pcall(function() inst[property] = c end)
    end
    local function applyTheme()
        for _, b in ipairs(themeBindings) do
            local c = Theme[b.key]
            if c ~= nil then
                if b.transform then c = b.transform(c) end
                pcall(function() b.inst[b.prop] = c end)
            end
        end
    end

