-- ====================================================================
-- Anti-fall platform (Colour Elimination)
-- ====================================================================
-- Creates a hidden 18×2×18 stud slab that follows the player during
-- the Colour Elimination event. When the wrong pad drops away the
-- player simply lands on this slab instead of falling out of the
-- world. Height is locked while grounded (using Humanoid.HipHeight),
-- so the slab never "sinks" beneath the player.

local Platform = { part = nil, lockFeetY = nil, eventId = nil }

local function ensurePlatform()
    if Platform.part and Platform.part.Parent then return Platform.part end
    local part = Instance.new("Part")
    part.Name        = "__VoidHub_AntiFallPlatform"
    part.Size        = Vector3.new(18, 2, 18)
    part.Anchored    = true
    part.CanCollide  = true
    part.CanQuery    = false
    part.CanTouch    = false
    part.Transparency = 1
    part.Material    = Enum.Material.SmoothPlastic
    part.TopSurface  = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth
    part.Parent      = workspace
    Platform.part    = part
    return part
end

local function destroyPlatform()
    if Platform.part then
        pcall(function() Platform.part:Destroy() end)
        Platform.part = nil
    end
    Platform.lockFeetY = nil
    Platform.eventId   = nil
end

local function updatePlatform()
    local part = ensurePlatform()
    if not part then return end
    local _, hum, root = characterInfo()
    local state = State.current or {}
    if state.id ~= Platform.eventId then
        Platform.eventId   = state.id
        Platform.lockFeetY = nil
    end
    if not root or not hum then
        part.CFrame = CFrame.new(0, -500, 0)
        return
    end
    -- HipHeight = distance from the floor to the root part's centre.
    -- Re-lock whenever the player is on solid ground.
    local hipH = hum.HipHeight or 2
    if hum.FloorMaterial ~= Enum.Material.Air then
        Platform.lockFeetY = root.Position.Y - hipH
    end
    local feetY = Platform.lockFeetY or (root.Position.Y - hipH)
    -- 2-stud-thick slab; centre 1 stud below the feet => top is flush
    -- with the locked floor level, so the player never sinks.
    part.CFrame = CFrame.new(root.Position.X, feetY - 1, root.Position.Z)
end

