        TextColor3 = HUB.Theme.SubText,
        TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true,
        Text = "Tool Scanner reads your Character + Backpack, classifies each " ..
               "tool by name (and by Handle/Remote structure if the name is " ..
               "uninformative), and lets you pick which one to swing. Auto " ..
               "Approach teleports melee/slap users right up to the target " ..
               "before swinging. Ranged/magic tools just aim and fire." })
end

