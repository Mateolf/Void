-- TAB 8 — AUTO FARM
---------------------------------------------------------------------------
do
    local farmTab = HUB.createTab("autofarm", "Auto Farm")

    local FarmState = {
        Checkpoints    = {},
        Finishes       = {},
        Blacklist      = {},
        AutoWinRunning = false,
        DelayBetweenTP = 0.15,
    }
    ENV.__VoidHub_FarmState = FarmState

    local function getHRP()
        local c = LocalPlayer.Character
        return c and c:FindFirstChild("HumanoidRootPart")
    end

    local function extractOrder(name)
        local n = tostring(name or ""):match("(%d+)")
        return tonumber(n) or math.huge
    end

    local CHECKPOINT_KW = {
        "checkpoint", "check_point", "check point",
        "stage", "level", "course", "obby", "parkour", "section",
    }
    local FINISH_KW = { "finish", "goal", "final" }
    local FINISH_WORDS = { "end", "win" }

    local JUNK_NAMES = {
        spawnlocation = true, baseplate = true, camera = true,
        terrain = true, spawn = true,
    }

    local function matchesKeywords(name, keywords)
        local n = tostring(name or ""):lower()
        for _, kw in ipairs(keywords) do
            if n:find(kw, 1, true) then return true end
        end
        return false
    end

    local function matchesWholeWord(name, words)
        local n = tostring(name or ""):lower()
        for _, w in ipairs(words) do
            if n == w
                or n:match("^" .. w .. "%W")
                or n:match("%W" .. w .. "$")
                or n:match("%W" .. w .. "%W") then
                return true
            end
        end
        return false
    end

    local function isCheckpointName(name)
        return matchesKeywords(name, CHECKPOINT_KW)
    end

    local function isFinishName(name)
        return matchesKeywords(name, FINISH_KW)
            or matchesWholeWord(name, FINISH_WORDS)
    end

    local function ancestorMatches(inst, matcher, maxDepth)
        maxDepth = maxDepth or 6
        local p = inst.Parent
        local d = 0
        while p and p ~= workspace and p ~= game and d < maxDepth do
            if matcher(p.Name) then return true, p end
            p = p.Parent
            d = d + 1
        end
        return false
    end

    local function classifyPart(inst)
        local nm = inst.Name
        local nmLower = nm:lower()
        if JUNK_NAMES[nmLower] then return nil end

        if isFinishName(nm)     then return "finish"     end
        if isCheckpointName(nm) then return "checkpoint" end

        local inFinish = ancestorMatches(inst, isFinishName)
        if inFinish then return "finish" end

        local inCp = ancestorMatches(inst, isCheckpointName)
        if inCp then return "checkpoint" end

        return nil
    end

    local function scanWorkspace()
        FarmState.Checkpoints = {}
        FarmState.Finishes    = {}

        local descendants
        local ok = pcall(function() descendants = workspace:GetDescendants() end)
        if not ok or type(descendants) ~= "table" then
            HUB.setStatus("Scan failed: could not read workspace.", "error")
            return
        end

        local seenCp, seenFin = {}, {}
        for _, inst in ipairs(descendants) do
            if inst:IsA("BasePart") and not FarmState.Blacklist[inst] then
                local kind = classifyPart(inst)
                if kind == "finish" then
                    if not seenFin[inst] then
                        seenFin[inst] = true
                        FarmState.Finishes[#FarmState.Finishes + 1] = inst
                    end
                elseif kind == "checkpoint" then
                    if not seenCp[inst] then
                        seenCp[inst] = true
                        FarmState.Checkpoints[#FarmState.Checkpoints + 1] = inst
                    end
                end
            end
        end

        table.sort(FarmState.Checkpoints, function(a, b)
            local na, nb = extractOrder(a.Name), extractOrder(b.Name)
            if na ~= nb then return na < nb end
            local pa = extractOrder(a.Parent and a.Parent.Name or "")
            local pb = extractOrder(b.Parent and b.Parent.Name or "")
            if pa ~= pb then return pa < pb end
            return a.Name < b.Name
        end)
    end

    local checkpointFrame, finishFrame, scanStatusLbl, autoWinStatusLbl
    local checkpointSectionHeader, clearCheckpointsBtn

    local function makeTargetRow(parent, inst, prefix)
        local row = new("Frame", { Parent = parent,
            Size = UDim2.new(1, 0, 0, isMobile and 42 or 36),
            BackgroundColor3 = HUB.Theme.SurfaceAlt, BorderSizePixel = 0 },
            { new("UICorner", { CornerRadius = UDim.new(0, 10) }) })
        new("UIStroke", { Parent = row, Thickness = 1, Color = HUB.Theme.Border,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Transparency = 0.4 })
        new("TextLabel", { Parent = row,
            Position = UDim2.new(0, 10, 0, 2), Size = UDim2.new(1, -160, 0, 16),
            BackgroundTransparency = 1, Font = HUB.Theme.Font,
            TextSize = isMobile and 12 or 11, TextColor3 = HUB.Theme.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Text = prefix .. inst.Name })
        new("TextLabel", { Parent = row,
            Position = UDim2.new(0, 10, 0, 18), Size = UDim2.new(1, -160, 0, 14),
            BackgroundTransparency = 1, Font = HUB.Theme.Font,
            TextSize = isMobile and 10 or 9, TextColor3 = HUB.Theme.SubText,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Text = inst:GetFullName() })
        local tpBtn = new("TextButton", { Parent = row,
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -8, 0.5, 0),
            Size = UDim2.fromOffset(66, 22),
            BackgroundColor3 = HUB.Theme.Accent,
            Font = HUB.Theme.Font, TextSize = isMobile and 11 or 10,
            TextColor3 = Color3.new(1, 1, 1), Text = "Teleport",
            AutoButtonColor = false, BorderSizePixel = 0 },
            { new("UICorner", { CornerRadius = UDim.new(0, 8) }) })
        bind(tpBtn.MouseButton1Click, function()
            local hrp = getHRP()
            if not hrp then HUB.setStatus("No character to teleport.", "error"); return end
            if not inst or not inst.Parent then
                HUB.setStatus("Target no longer exists.", "error"); return
            end
            local ok, err = pcall(function()
                hrp.CFrame = CFrame.new(inst.Position + Vector3.new(0, 3, 0))
            end)
            if ok then HUB.setStatus("Teleported to " .. inst.Name .. ".", "success")
            else HUB.setStatus("TP failed: " .. tostring(err), "error") end
        end)
        local rmBtn = new("TextButton", { Parent = row,
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -78, 0.5, 0),
            Size = UDim2.fromOffset(24, 22),
            BackgroundColor3 = Color3.fromRGB(80, 40, 40),
            Font = HUB.Theme.Font, TextSize = isMobile and 12 or 11,
            TextColor3 = Color3.fromRGB(255, 200, 200), Text = "✕",
            AutoButtonColor = false, BorderSizePixel = 0 },
            { new("UICorner", { CornerRadius = UDim.new(0, 8) }) })
        bind(rmBtn.MouseButton1Click, function()
            FarmState.Blacklist[inst] = true
            for i, v in ipairs(FarmState.Checkpoints) do
                if v == inst then table.remove(FarmState.Checkpoints, i); break end
            end
            for i, v in ipairs(FarmState.Finishes) do
                if v == inst then table.remove(FarmState.Finishes, i); break end
            end
            refreshLists()
            HUB.setStatus("Removed from list (won't reappear on rescan).")
        end)
        return row
    end

    local function refreshLists()
        for _, c in ipairs(checkpointFrame:GetChildren()) do
            if c:IsA("Frame") then c:Destroy() end
        end
        for _, c in ipairs(finishFrame:GetChildren()) do
            if c:IsA("Frame") then c:Destroy() end
        end
        for i, cp in ipairs(FarmState.Checkpoints) do
            makeTargetRow(checkpointFrame, cp, ("%d. "):format(i))
        end
        for _, fin in ipairs(FarmState.Finishes) do
            makeTargetRow(finishFrame, fin, "★ ")
        end
        if #FarmState.Finishes == 0 then
            new("TextLabel", { Parent = finishFrame,
                Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1,
                Font = HUB.Theme.Font, TextSize = 11,
                TextColor3 = HUB.Theme.SubText,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = "  (none found)" })
        end

        -- Collapse the entire checkpoints block when the list is empty.
        local hasCheckpoints = #FarmState.Checkpoints > 0
        if checkpointSectionHeader then
            checkpointSectionHeader.Visible = hasCheckpoints
        end
        if clearCheckpointsBtn then
            clearCheckpointsBtn.Visible = hasCheckpoints
        end
        if checkpointFrame then
            checkpointFrame.Visible = hasCheckpoints
        end

        if scanStatusLbl then
            scanStatusLbl.Text = ("Found %d checkpoint(s), %d finish block(s).")
                :format(#FarmState.Checkpoints, #FarmState.Finishes)
        end
    end

    local function doAutoWin()
        if FarmState.AutoWinRunning then
            HUB.setStatus("Auto-Win is already running.", "error"); return
        end
        scanWorkspace()
        refreshLists()
        if #FarmState.Checkpoints == 0 and #FarmState.Finishes == 0 then
            HUB.setStatus("Auto-Win: no checkpoints or finish found.", "error"); return
        end
        FarmState.AutoWinRunning = true
        HUB.setStatus("Auto-Win started.", "success")
        task.spawn(function()
            local ok, err = pcall(function()
                for i, cp in ipairs(FarmState.Checkpoints) do
                    if not FarmState.AutoWinRunning then break end
                    local hrp = getHRP()
                    if hrp and cp and cp.Parent then
                        hrp.CFrame = CFrame.new(cp.Position + Vector3.new(0, 3, 0))
                        if autoWinStatusLbl then
                            autoWinStatusLbl.Text = ("Auto-Win: checkpoint %d / %d")
                                :format(i, #FarmState.Checkpoints)
                        end
                    end
                    task.wait(FarmState.DelayBetweenTP)
                end
                for i, fin in ipairs(FarmState.Finishes) do
                    if not FarmState.AutoWinRunning then break end
                    local hrp = getHRP()
                    if hrp and fin and fin.Parent then
                        hrp.CFrame = CFrame.new(fin.Position + Vector3.new(0, 3, 0))
                        if autoWinStatusLbl then
                            autoWinStatusLbl.Text = ("Auto-Win: finish %d / %d")
                                :format(i, #FarmState.Finishes)
                        end
                    end
                    task.wait(FarmState.DelayBetweenTP)
                end
            end)
            FarmState.AutoWinRunning = false
            if autoWinStatusLbl then autoWinStatusLbl.Text = "Auto-Win: idle" end
            if ok then HUB.setStatus("Auto-Win complete.", "success")
            else HUB.setStatus("Auto-Win error: " .. tostring(err), "error") end
        end)
    end

    HUB.sectionHeader(farmTab.page, "Scanner")
    scanStatusLbl = new("TextLabel", { Parent = farmTab.page,
        LayoutOrder = HUB.nOrder(), Size = UDim2.new(1, 0, 0, 22),
        BackgroundTransparency = 1, Font = HUB.Theme.Font,
        TextSize = isMobile and 11 or 10, TextColor3 = HUB.Theme.SubText,
        TextXAlignment = Enum.TextXAlignment.Left, Text = "Not scanned yet." })
    new("TextLabel", { Parent = farmTab.page,
        LayoutOrder = HUB.nOrder(), Size = UDim2.new(1, 0, 0, 30),
        BackgroundTransparency = 1, Font = HUB.Theme.Font,
        TextSize = isMobile and 10 or 9, TextColor3 = HUB.Theme.SubText,
        TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true,
        Text = "Looks at part names, AND at folder names like " ..
               "Checkpoints / Stages / Course / Finish / Goal. " ..
               "Numeric-named parts inside those folders count too. " ..
               "Tap ✕ to permanently remove a false positive." })
    HUB.makeButton(farmTab.page, "Scan Workspace", function()
        scanWorkspace()
        refreshLists()
        HUB.setStatus(("Scan complete: %d checkpoints, %d finishes.")
            :format(#FarmState.Checkpoints, #FarmState.Finishes), "success")
    end)
    HUB.makeButton(farmTab.page, "Un-prune all (clear blacklist)", function()
        FarmState.Blacklist = {}
        scanWorkspace()
        refreshLists()
        HUB.setStatus("Blacklist cleared and workspace rescanned.", "success")
    end)

    HUB.sectionHeader(farmTab.page, "Auto-Win")
    autoWinStatusLbl = new("TextLabel", { Parent = farmTab.page,
        LayoutOrder = HUB.nOrder(), Size = UDim2.new(1, 0, 0, 20),
        BackgroundTransparency = 1, Font = HUB.Theme.Font,
        TextSize = isMobile and 11 or 10, TextColor3 = HUB.Theme.Accent,
        TextXAlignment = Enum.TextXAlignment.Left, Text = "Auto-Win: idle" })
    HUB.makeSlider(farmTab.page, "Delay between teleports (s)", 0, 1, 0.15,
        function(v) FarmState.DelayBetweenTP = v end)
    HUB.makeButton(farmTab.page, "▶  Start Auto-Win", doAutoWin)
    HUB.makeButton(farmTab.page, "■  Stop Auto-Win", function()
        FarmState.AutoWinRunning = false
        HUB.setStatus("Auto-Win stopped.")
    end)

    -- Checkpoints section (collapses entirely when the list is empty)
    checkpointSectionHeader = HUB.sectionHeader(farmTab.page, "Checkpoints")

    clearCheckpointsBtn = HUB.makeButton(farmTab.page,
        "Remove All Checkpoints", function()
            FarmState.Checkpoints = {}
            refreshLists()
            HUB.setStatus("All checkpoints cleared.", "success")
        end)

    checkpointFrame = new("Frame", { Parent = farmTab.page,
        LayoutOrder = HUB.nOrder(), Size = UDim2.new(1, 0, 0, 0),
        BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.Y })
    new("UIListLayout", { Parent = checkpointFrame, Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder })

    HUB.sectionHeader(farmTab.page, "Finish / Goal")
    finishFrame = new("Frame", { Parent = farmTab.page,
        LayoutOrder = HUB.nOrder(), Size = UDim2.new(1, 0, 0, 0),
        BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.Y })
    new("UIListLayout", { Parent = finishFrame, Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder })

    -- Start collapsed (nothing has been scanned yet).
    checkpointSectionHeader.Visible = false
    clearCheckpointsBtn.Visible = false
    checkpointFrame.Visible = false

    local _origFarmSelect = farmTab.select
    farmTab.select = function()
        _origFarmSelect()
        task.spawn(function()
            task.wait(0.05)
            scanWorkspace()
            refreshLists()
        end)
    end
end

