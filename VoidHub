do
    local saverTab = HUB.createTab("saver", "Game Saver")
    local hasFS = type(writefile) == "function"
        and type(makefolder) == "function"
        and type(isfolder) == "function"

    local saverOpts = {
        running = false, format = "rbxlx", maxInstances = 20000,
        maxScripts = 200, delayBetween = 0.1, decompile = true,
        saveTerrain = false, terrainVoxel = 8,
    }
    ENV.__VoidHub_Saver = saverOpts

    local MATERIAL_IDS = {}
    pcall(function()
        for _, item in ipairs(Enum.Material:GetEnumItems()) do
            MATERIAL_IDS[item.Name] = item.Value
        end
    end)

    local SERVICE_WHITELIST = {
        Workspace = true, Lighting = true, ReplicatedFirst = true,
        ReplicatedStorage = true, ServerScriptService = true, ServerStorage = true,
        StarterGui = true, StarterPack = true, StarterPlayer = true,
        SoundService = true, Chat = true, Teams = true, TextChatService = true,
    }
    local CLASS_SKIP = { Camera = true, Terrain = true }

    local function getEffectiveDelay()
        if not saverOpts.decompile then return 0.02 end
        return saverOpts.delayBetween
    end

    local function pathSafe(name)
        name = tostring(name):gsub("[\\/:*?\"<>|]", "_")
        if #name == 0 then name = "unnamed" end
        return name
    end

    local function getDecompiler()
        if type(decompile) == "function" then return decompile end
        if type(syn) == "table" and type(syn.decompile) == "function" then
            return syn.decompile
        end
        return nil
    end

    local function getScriptSource(inst)
        local ok, src = pcall(function() return inst.Source end)
        if ok and type(src) == "string" and #src > 0 then return src, "source" end
        if not saverOpts.decompile then return nil, "skipped" end
        local dec = getDecompiler()
        if not dec then return nil, "no-decompiler" end
        local ok2, d = pcall(dec, inst)
        if ok2 and type(d) == "string" and #d > 0 then return d, "decompiled" end
        return nil, "unavailable"
    end

    local function xmlEscape(s)
        return tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub("\"", "&quot;")
    end

    local function xmlCDATA(s)
        return "<![CDATA[" .. tostring(s):gsub("]]>", "]]]]><![CDATA[>") .. "]]>"
    end

    local function serializeInstance(inst, out, counter, depth)
        if depth > 64 or counter.n >= counter.max then return end
        if CLASS_SKIP[inst.ClassName] then return end
        counter.n += 1
        if counter.n % 2000 == 0 then
            HUB.setStatus(string.format("Serializing... %d / %d", counter.n, counter.max), nil, true)
            task.wait()
        end
        out[#out + 1] = '<Item class="' .. xmlEscape(inst.ClassName) .. '" referent="RBX' .. counter.n .. '">'
        out[#out + 1] = '<Properties>'
        out[#out + 1] = '<string name="Name">' .. xmlEscape(inst.Name) .. '</string>'

        if inst:IsA("LuaSourceContainer") then
            local src = getScriptSource(inst)
            if src then
                out[#out + 1] = '<ProtectedString name="Source">' .. xmlCDATA(src) .. '</ProtectedString>'
            end
        end

        if inst:IsA("BasePart") then
            local ok, cf = pcall(function() return inst.CFrame end)
            if ok and cf then
                local r, u, b = cf.RightVector, cf.UpVector, -cf.LookVector
                out[#out + 1] = table.concat({
                    '<CoordinateFrame name="CFrame">',
                    '<X>', cf.X, '</X><Y>', cf.Y, '</Y><Z>', cf.Z, '</Z>',
                    '<R00>', r.X, '</R00><R01>', u.X, '</R01><R02>', b.X, '</R02>',
                    '<R10>', r.Y, '</R10><R11>', u.Y, '</R11><R12>', b.Y, '</R12>',
                    '<R20>', r.Z, '</R20><R21>', u.Z, '</R21><R22>', b.Z, '</R22>',
                    '</CoordinateFrame>' })
            end
            local ok2, sz = pcall(function() return inst.Size end)
            if ok2 and sz then
                out[#out + 1] = '<Vector3 name="size"><X>' .. sz.X .. '</X><Y>' .. sz.Y .. '</Y><Z>' .. sz.Z .. '</Z></Vector3>'
            end
            if inst.Anchored ~= nil then
                out[#out + 1] = '<bool name="Anchored">' .. (inst.Anchored and "true" or "false") .. '</bool>'
            end
            if inst.CanCollide ~= nil then
                out[#out + 1] = '<bool name="CanCollide">' .. (inst.CanCollide and "true" or "false") .. '</bool>'
            end
            local matOk, matName = pcall(function() return inst.Material.Name end)
            if matOk and matName then
                out[#out + 1] = '<token name="Material">' .. (MATERIAL_IDS[matName] or 256) .. '</token>'
            end
            local colOk, col = pcall(function() return inst.Color end)
            if colOk and col then
                out[#out + 1] = string.format('<Color3 name="Color"><R>%.6f</R><G>%.6f</G><B>%.6f</B></Color3>', col.R, col.G, col.B)
            end
        end

        if inst:IsA("MeshPart") then
            local mok, mid = pcall(function() return inst.MeshId end)
            if mok and type(mid) == "string" and mid ~= "" then
                out[#out + 1] = '<Content name="MeshId"><url>' .. xmlEscape(mid) .. '</url></Content>'
            end
            local tok, tid = pcall(function() return inst.TextureID end)
            if tok and type(tid) == "string" and tid ~= "" then
                out[#out + 1] = '<Content name="TextureID"><url>' .. xmlEscape(tid) .. '</url></Content>'
            end
        end

        if inst:IsA("SpecialMesh") then
            local mok, mid = pcall(function() return inst.MeshId end)
            if mok and type(mid) == "string" and mid ~= "" then
                out[#out + 1] = '<Content name="MeshId"><url>' .. xmlEscape(mid) .. '</url></Content>'
            end
            local tok, tid = pcall(function() return inst.TextureId end)
            if tok and type(tid) == "string" and tid ~= "" then
                out[#out + 1] = '<Content name="TextureId"><url>' .. xmlEscape(tid) .. '</url></Content>'
            end
        end

        if inst:IsA("Decal") or inst:IsA("Texture") then
            local ok, tex = pcall(function() return inst.Texture end)
            if ok and type(tex) == "string" and tex ~= "" then
                out[#out + 1] = '<Content name="Texture"><url>' .. xmlEscape(tex) .. '</url></Content>'
            end
        end

        if inst:IsA("ParticleEmitter") or inst:IsA("Beam") or inst:IsA("Trail") then
            local ok, tex = pcall(function() return inst.Texture end)
            if ok and type(tex) == "string" and tex ~= "" then
                out[#out + 1] = '<Content name="Texture"><url>' .. xmlEscape(tex) .. '</url></Content>'
            end
        end

        out[#out + 1] = '</Properties>'
        local ok3, children = pcall(function() return inst:GetChildren() end)
        if ok3 and children then
            for _, child in ipairs(children) do
                if counter.n >= counter.max then break end
                serializeInstance(child, out, counter, depth + 1)
            end
        end
        out[#out + 1] = '</Item>'
    end

    local function buildRbxlx()
        local counter = { n = 0, max = saverOpts.maxInstances }
        local out = {
            '<?xml version="1.0" encoding="utf-8"?>',
            '<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" ' ..
            'xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ' ..
            'xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">',
            '<Meta name="ExplicitAutoJoints">true</Meta>',
        }
        local ok, services = pcall(function() return game:GetChildren() end)
        if ok and services then
            local filtered = {}
            for _, svc in ipairs(services) do
                if SERVICE_WHITELIST[svc.ClassName] then
                    filtered[#filtered + 1] = svc
                end
            end
            table.sort(filtered, function(a, b)
                if a.ClassName == "Workspace" then return true end
                if b.ClassName == "Workspace" then return false end
                return a.ClassName < b.ClassName
            end)
            for _, svc in ipairs(filtered) do
                if counter.n >= counter.max then
                    HUB.setStatus("Hit instance limit at " .. svc.ClassName, "error")
                    break
                end
                pcall(serializeInstance, svc, out, counter, 1)
            end
        end
        out[#out + 1] = '</roblox>'
        return table.concat(out), counter.n
    end

    local function saveFolder(rootFolder)
        local stamp = os.date("%Y%m%d_%H%M%S")
        local outRoot = string.format("%s_%s_%s", rootFolder, tostring(game.PlaceId), stamp)
        if not isfolder(outRoot) then makefolder(outRoot) end
        local folderCache = { [outRoot] = true }
        local function ensureFolder(path)
            if folderCache[path] then return true end
            if isfolder(path) then folderCache[path] = true; return true end
            local ok = pcall(makefolder, path)
            if ok then folderCache[path] = true end
            return ok
        end
        local saved, failed, skipped = 0, 0, 0
        local scripts = {}
        local queue = { game }
        local head = 1
        local visited = 0
        while head <= #queue and #scripts < saverOpts.maxScripts do
            local node = queue[head]
            head += 1
            for _, child in ipairs(node:GetChildren()) do
                queue[#queue + 1] = child
            end
            local cls = node.ClassName
            if cls == "Script" or cls == "LocalScript" or cls == "ModuleScript" then
                scripts[#scripts + 1] = node
            end
            visited += 1
            if visited % 2000 == 0 then RunService.Heartbeat:Wait() end
        end
        for i, inst in ipairs(scripts) do
            task.wait(getEffectiveDelay())
            HUB.setStatus(string.format("Saving... %d / %d", i, #scripts), nil, true)
            local src, method = getScriptSource(inst)
            if src then
                local parts = {}
                local parent = inst.Parent
                local depth = 0
                while parent and parent ~= game and depth < 32 do
                    table.insert(parts, 1, pathSafe(parent.Name))
                    parent = parent.Parent
                    depth += 1
                end
                local current = outRoot
                for _, seg in ipairs(parts) do
                    current = current .. "/" .. seg
                    ensureFolder(current)
                end
                local ext = inst.ClassName == "ModuleScript" and ".module.lua" or ".lua"
                local fname = pathSafe(inst.Name) .. " [" .. inst.ClassName .. "]" .. ext
                local header = string.format("-- VoidHub %s\n-- Class: %s\n-- Method: %s\n\n",
                    HUB_VERSION, inst.ClassName, method)
                if pcall(writefile, current .. "/" .. fname, header .. src) then
                    saved += 1
                else
                    failed += 1
                end
            elseif method == "skipped" then
                skipped += 1
            else
                failed += 1
            end
        end
        return saved, failed, skipped, outRoot
    end

    local function saveGame(rootFolder)
        if not hasFS then HUB.setStatus("File system unavailable.", "error"); return end
        if saverOpts.running then HUB.setStatus("A save is already in progress."); return end
        saverOpts.running = true
        HUB.__saving = true
        local stamp = os.date("%Y%m%d_%H%M%S")
        local baseName = string.format("%s_%s_%s", pathSafe(rootFolder),
            tostring(game.PlaceId), stamp)
        if saverOpts.format == "rbxlx" then
            HUB.setStatus("Building .rbxlx (up to " .. saverOpts.maxInstances .. " instances)...")
            RunService.Heartbeat:Wait()
            local ok, xml, count = pcall(buildRbxlx)
            if not ok then
                saverOpts.running = false
                HUB.__saving = false
                HUB.setStatus("Serialize failed: " .. tostring(xml), "error")
                return
            end
            HUB.setStatus(string.format("Writing .rbxlx (%d instances, %d KB)...",
                count, math.floor(#xml / 1024)))
            RunService.Heartbeat:Wait()
            local placeFile = baseName .. ".rbxlx"
            if not pcall(writefile, placeFile, xml) then
                saverOpts.running = false
                HUB.__saving = false
                HUB.setStatus("writefile failed for " .. placeFile, "error")
                return
            end
            saverOpts.running = false
            HUB.__saving = false
            HUB.setStatus(string.format("Saved %d instances → %s", count, placeFile), "success")
            HUB.notify(HUB_NAME, "Saved: " .. placeFile, 6)
        else
            HUB.setStatus("Building folder dump...")
            RunService.Heartbeat:Wait()
            local ok, saved, failed, skipped, outRoot = pcall(saveFolder, rootFolder)
            saverOpts.running = false
            HUB.__saving = false
            if not ok then
                HUB.setStatus("Save failed: " .. tostring(saved), "error")
                return
            end
            HUB.setStatus(string.format("Saved %d, skipped %d, failed %d → %s",
                saved, skipped, failed, outRoot), "success")
            HUB.notify(HUB_NAME, "Game saved: " .. outRoot, 6)
        end
    end

    HUB.sectionHeader(saverTab.page, "Save Format")
    HUB.makeToggle(saverTab.page, "Save as .rbxlx (opens in Studio)", true, function(v)
        saverOpts.format = v and "rbxlx" or "folder"
        HUB.setStatus("Format: " .. saverOpts.format)
    end)
    HUB.sectionHeader(saverTab.page, "Save Options")
    HUB.makeToggle(saverTab.page, "Decompile scripts", true, function(v)
        saverOpts.decompile = v
        HUB.setStatus("Decompile " .. (v and "enabled." or "disabled (source-only)."))
    end)
    HUB.makeSlider(saverTab.page, "Max instances", 500, 50000, 20000,
        function(v) saverOpts.maxInstances = math.floor(v) end)
    HUB.makeSlider(saverTab.page, "Delay between scripts (s, folder mode)", 0, 0.5, 0.1,
        function(v) saverOpts.delayBetween = v end)
    HUB.sectionHeader(saverTab.page, "Save")

    if not hasFS then
        new("TextLabel", { Parent = saverTab.page, LayoutOrder = HUB.nOrder(),
            Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1,
            Font = HUB.Theme.Font, TextSize = 11, TextColor3 = HUB.Theme.Error,
            Text = "writefile/makefolder unavailable — saver disabled." })
    end

    local outFolderName = "SavedGame"
    HUB.makeInput(saverTab.page, "Output name", "SavedGame", function(v)
        if v and v ~= "" then outFolderName = v end
    end)
    HUB.makeButton(saverTab.page, "Save Game", function()
        if not hasFS then HUB.setStatus("Saver unavailable.", "error"); return end
        task.spawn(function()
            local ok, err = pcall(saveGame, outFolderName)
            if not ok then
                saverOpts.running = false
                HUB.__saving = false
                HUB.setStatus("Save failed: " .. tostring(err), "error")
            end
        end)
    end)
end

