            ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Transparency = 0.15 })
        new("Frame", { Parent = warn, Name = "AccentBar",
            Size = UDim2.new(0, 5, 1, 0),
            BackgroundColor3 = Color3.fromRGB(255, 70, 70), BorderSizePixel = 0 })
        new("TextLabel", { Parent = warn,
            Position = UDim2.new(0, 18, 0, 6), Size = UDim2.new(1, -30, 0, 18),
            BackgroundTransparency = 1, Font = HUB.Theme.Font, TextSize = 11,
            TextColor3 = Color3.fromRGB(255, 170, 170),
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = "⚠  WARNING  ⚠" })
        local warnLbl = new("TextLabel", { Parent = warn,
            Position = UDim2.new(0, 18, 0, 24), Size = UDim2.new(1, -30, 0, 36),
            BackgroundTransparency = 1, Font = HUB.Theme.Font, TextSize = 17,
            TextColor3 = Color3.fromRGB(255, 90, 90),
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            TextWrapped = true,
            Text = "DO NOT USE UNLESS YOU KNOW WHAT YOU ARE DOING" })
        task.spawn(function()
            local colors = {
                Color3.fromRGB(255, 90, 90),
                Color3.fromRGB(255, 160, 160),
                Color3.fromRGB(255, 55, 55),
            }
            local i = 1
            while warnLbl and warnLbl.Parent do
                i = (i % #colors) + 1
                TweenService:Create(warnLbl,
                    TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
                    { TextColor3 = colors[i] }):Play()
                task.wait(1.5)
            end
        end)
    end

    local SCRIPTS = {
        ["Cobalt"]                = { url = COBALT_URL,        flag = "VoidHub_Cobalt" },
        ["Infinite Yield"]        = { url = IY_URL,            flag = "VoidHub_IY" },
        ["Product Faker - Vaehz"] = { url = PRODUCT_FAKER_URL, flag = "VoidHub_ProductFaker" },
        ["Dex++"]                 = { url = DEX_URL,           flag = "VoidHub_Dex" },
    }
    local loading = {}
    local function loadScript(name)
        local info = SCRIPTS[name]
        if not info or loading[name] or ENV[info.flag] then return end
        loading[name] = true
        HUB.setStatus("Fetching " .. name .. "...")
        task.spawn(function()
            local ok, err = pcall(function()
                local source = game:HttpGet(info.url)
                if type(source) ~= "string" or #source == 0 then
                    error("server returned an empty response")
                end
                local chunk = (loadstring or load)(source, name)
                if not chunk then error("could not compile downloaded source") end
                chunk()
                ENV[info.flag] = true
            end)
            loading[name] = nil
            if ok then
                HUB.setStatus(name .. " loaded successfully.", "success")
                HUB.notify(HUB_NAME, name .. " loaded.", 4)
            else
                ENV[info.flag] = nil
                HUB.setStatus(name .. " failed: " .. tostring(err), "error")
            end
        end)
    end

    HUB.sectionHeader(scriptsTab.page, "Bundled Scripts")
    HUB.makeButton(scriptsTab.page, "Load Cobalt",                function() loadScript("Cobalt") end)
    HUB.makeButton(scriptsTab.page, "Load Infinite Yield",        function() loadScript("Infinite Yield") end)
    HUB.makeButton(scriptsTab.page, "Load Product Faker - Vaehz", function() loadScript("Product Faker - Vaehz") end)
    HUB.makeButton(scriptsTab.page, "Load Dex++",                 function() loadScript("Dex++") end)

    HUB.sectionHeader(scriptsTab.page, "Custom Loader")
    HUB.makeInput(scriptsTab.page, "Paste raw Lua here and press Enter...", "", function(text)
        if not text or text == "" then return end
        local chunk, err = (loadstring or load)(text, "CustomScript")
        if not chunk then HUB.setStatus("Compile error: " .. tostring(err), "error"); return end
        local ok, runtimeErr = pcall(chunk)
        if ok then HUB.setStatus("Custom script executed.", "success")
        else HUB.setStatus("Runtime error: " .. tostring(runtimeErr), "error") end
    end)
    HUB.makeInput(scriptsTab.page, "Or fetch and run from a URL...", "", function(url)
        if not url or url == "" then return end
        task.spawn(function()
            local ok, err = pcall(function()
                local src = game:HttpGet(url)
                local chunk = (loadstring or load)(src, "RemoteScript")
                if not chunk then error("could not compile remote source") end
                chunk()
            end)
            if ok then HUB.setStatus("Remote script executed.", "success")
            else HUB.setStatus("Remote failed: " .. tostring(err), "error") end
        end)
    end)
end

