            end)
        end
        if #Combat.DetectedTools == 0 then
            new("TextLabel", { Parent = toolsListFrame,
                Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1,
                Font = HUB.Theme.Font, TextSize = 11,
                TextColor3 = HUB.Theme.SubText,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = "  (no tools found)" })
        end
        toolsStatusLbl.Text = ("Detected %d tool(s)."):format(#Combat.DetectedTools)
    end

    HUB.makeButton(combatTab.page, "Scan Player Tools", function()
        refreshToolList()
        HUB.setStatus(("Scanned: %d tool(s)."):format(#Combat.DetectedTools), "success")
    end)
    HUB.makeButton(combatTab.page, "Clear Preferred Tool", function()
        Combat.PreferredTool = nil
        Combat.PreferredKind = nil
        preferredLbl.Text = "Preferred: (auto)"
        HUB.setStatus("Preferred tool cleared — using equipped/first.")
    end)

    HUB.sectionHeader(combatTab.page, "Auto Target")
    HUB.makeToggle(combatTab.page, "Enable Auto Target", false, function(v)
