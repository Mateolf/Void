    local function makeSlider(parent, text, min, max, default, callback)
        local value = default or min
        local row = new("Frame", { Parent = parent, LayoutOrder = nOrder(),
            Size = UDim2.new(1, 0, 0, SLIDER_H),
            BackgroundColor3 = Theme.SurfaceAlt, BorderSizePixel = 0 },
            { new("UICorner", { CornerRadius = UDim.new(0, 12) }) })
        bindTheme(row, "BackgroundColor3", "SurfaceAlt")
        local rowStroke = new("UIStroke", { Parent = row, Thickness = 1, Color = Theme.Border,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Transparency = 0.3 })
        bindTheme(rowStroke, "Color", "Border")
        local lbl = new("TextLabel", { Parent = row,
            Position = UDim2.new(0, 14, 0, 4), Size = UDim2.new(1, -90, 0, 18),
            BackgroundTransparency = 1, Font = Theme.Font,
            TextSize = isMobile and 13 or 12, TextColor3 = Theme.Text,
            TextXAlignment = Enum.TextXAlignment.Left, Text = text })
        bindTheme(lbl, "TextColor3", "Text")
        bindTheme(lbl, "Font", "Font")
        local valLbl = new("TextLabel", { Parent = row,
            AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 4),
            Size = UDim2.fromOffset(70, 18), BackgroundTransparency = 1,
            Font = Theme.Font, TextSize = isMobile and 13 or 12,
            TextColor3 = Theme.Accent, TextXAlignment = Enum.TextXAlignment.Right,
            Text = tostring(value) })
        bindTheme(valLbl, "TextColor3", "Accent")
        bindTheme(valLbl, "Font", "Font")
        local track = new("Frame", { Parent = row,
            Position = UDim2.new(0, 14, 0, isMobile and 32 or 26),
            Size = UDim2.new(1, -28, 0, isMobile and 6 or 5),
            BackgroundColor3 = Theme.Border, BorderSizePixel = 0,
            BackgroundTransparency = 0.5 },
            { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
        bindTheme(track, "BackgroundColor3", "Border")
        local fill = new("Frame", { Parent = track,
            Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
            BackgroundColor3 = Theme.Accent, BorderSizePixel = 0 },
            { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
        bindTheme(fill, "BackgroundColor3", "Accent")
        local knob = new("Frame", { Parent = track,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new((value - min) / (max - min), 0, 0.5, 0),
            Size = UDim2.fromOffset(isMobile and 16 or 14, isMobile and 16 or 14),
            BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 },
            { new("UICorner", { CornerRadius = UDim.new(1, 0) }),
              new("UIStroke", { Thickness = 2, Color = Theme.Accent,
                  ApplyStrokeMode = Enum.ApplyStrokeMode.Border }) })
        local dragging = false
        local function update(input)
            local pos = math.clamp(
                (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            value = min + (max - min) * pos
            fill.Size = UDim2.new(pos, 0, 1, 0)
            knob.Position = UDim2.new(pos, 0, 0.5, 0)
            valLbl.Text = tostring(math.floor(value * 100) / 100)
            if callback then
                local ok, err = pcall(callback, value)
                if not ok then setStatus("Error: " .. tostring(err), "error") end
            end
        end
        local hit = new("TextButton", { Parent = row,
            Position = UDim2.new(0, 14, 0, isMobile and 24 or 20),
            Size = UDim2.new(1, -28, 0, isMobile and 22 or 18),
            BackgroundTransparency = 1, Text = "" })
        bind(hit.InputBegan, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true; update(input)
            end
        end)
        bind(UserInputService.InputChanged, function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then update(input) end
        end)
        bind(UserInputService.InputEnded, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
        end)
        return { Get = function() return value end, Set = function(v)
            value = v
            local p = (v - min) / (max - min)
            fill.Size = UDim2.new(p, 0, 1, 0)
            knob.Position = UDim2.new(p, 0, 0.5, 0)
            valLbl.Text = tostring(math.floor(v * 100) / 100)
        end }
    end

