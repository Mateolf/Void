-- ====================================================================
-- State plumbing
-- ====================================================================

local function applyState(nextState)
    if type(nextState) ~= "table" then return end
    local previous = State.current or {}
    State.current = nextState
    if nextState.id ~= nil and nextState.id ~= previous.id then
        State.joinedAt = nextState.id and os.clock() or 0
        World.invalidate()
        log(("state: %s [%s]"):format(tostring(nextState.kind), tostring(nextState.phase)))
    end
end

local function invoke(action, args)
    if not eventRequest then
        return nil, "ForestEventRequest is unavailable"
    end
    if State.inFlight then
        return nil, "another event request is in flight"
    end
    State.inFlight = true
    local started = os.clock()
    local ok, result = pcall(function()
        return eventRequest:InvokeServer(action, args or {})
    end)
    State.inFlight = false
    if not ok then
        State.lastError = tostring(result)
        log(("request %s failed: %s"):format(action, tostring(result)))
        return nil, tostring(result)
    end
    if type(result) ~= "table" then
        State.lastError = "unexpected reply: " .. tostring(result)
        return nil, State.lastError
    end
    if result.state  then applyState(result.state) end
    if result.events then State.events = result.events end
    if not result.ok then State.lastError = tostring(result.message) end
    State.lastAction = ("%s in %.0f ms"):format(action, (os.clock() - started) * 1000)
    return result
end

local function myEntry(state)
    state = state or State.current
    local list = state and state.players
    if type(list) ~= "table" then return nil end
    return list[tostring(LocalPlayer.UserId)]
