local function hideSeekBounds()
    local cf = LocalPlayer:GetAttribute("ForestHideSeekBounds")
    if typeof(cf) ~= "CFrame" then return nil end
    return cf,
        tonumber(LocalPlayer:GetAttribute("ForestHideSeekHalfWidth")) or 275,
        tonumber(LocalPlayer:GetAttribute("ForestHideSeekHalfDepth")) or 275,
        tonumber(LocalPlayer:GetAttribute("ForestHideSeekMinY"))      or 0,
        tonumber(LocalPlayer:GetAttribute("ForestHideSeekMaxY"))      or 60
end

local function otherPlayers()
    local out = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            local humanoid  = character and character:FindFirstChildOfClass("Humanoid")
            local root      = character and character:FindFirstChild("HumanoidRootPart")
            if humanoid and root and humanoid.Health > 0 then
                out[#out + 1] = {
                    player   = player,
                    root     = root,
                    humanoid = humanoid,
                    role     = player:GetAttribute("ForestHideSeekRole"),
                }
            end
        end
    end
    return out
end

local function nearestPlayer(maxDistance, skipGhosts)
    local _, _, root = characterInfo()
    if not root then return nil end
    local best, bestDistance
    for _, entry in ipairs(otherPlayers()) do
        if not (skipGhosts and entry.role == "Ghost") then
            local distance = (entry.root.Position - root.Position).Magnitude
            if distance <= maxDistance and (bestDistance == nil or distance < bestDistance) then
                best, bestDistance = entry, distance
            end
        end
    end
    return best, bestDistance
end

local function packCenter(maxDistance)
    local _, _, root = characterInfo()
    if not root then return nil end
    local sum, count = Vector3.zero, 0
    for _, entry in ipairs(otherPlayers()) do
        local position = entry.root.Position
        if (position - root.Position).Magnitude <= (maxDistance or 400) then
            sum = sum + position
            count = count + 1
        end
    end
    if count == 0 then return nil end
    return sum / count
end

local COVER_DIRECTIONS = {
    Vector3.new(0, 1, 0),
    Vector3.new(0, -1, 0),
    Vector3.new(1, 0, 0),
    Vector3.new(-1, 0, 0),
    Vector3.new(0, 0, 1),
    Vector3.new(0, 0, -1),
}

local function coverScore(point)
    local hits, ground = 0, false
    for index, direction in ipairs(COVER_DIRECTIONS) do
        local result = raycast(point, direction, 14)
        if result then
            hits = hits + 1
            if index == 2 and result.Distance <= 9 then
                ground = true
            end
        end
    end
    return hits, ground
end

local function findHidingSpot()
    local cf, halfWidth, halfDepth, minY, maxY = hideSeekBounds()
    if not cf then return nil end
    local _, _, root = characterInfo()
    if not root then return nil end
    local seeker = nearestPlayer(1e4, true)
    local radius = math.clamp(Config.hideRadius, 20, 400)
    local best, bestScore
    for _ = 1, 26 do
        local angle    = math.random() * math.pi * 2
        local distance = math.random() * radius
        local x = cf.Position.X + math.cos(angle) * distance
        local z = cf.Position.Z + math.sin(angle) * distance
        if math.abs(x - cf.Position.X) <= halfWidth
            and math.abs(z - cf.Position.Z) <= halfDepth then
            local top    = cf.Position.Y + maxY
            local bottom = cf.Position.Y + minY
            local hit = raycast(Vector3.new(x, top, z), Vector3.new(0, -1, 0), (top - bottom) + 24)
            if hit then
                local point = hit.Position + Vector3.new(0, 3, 0)
                local hits, ground = coverScore(point)
                if ground then
                    local score = hits * 12 - (point - root.Position).Magnitude * 0.06
                    if seeker then
                        score = score + math.min((point - seeker.root.Position).Magnitude, 300) * 0.08
                    end
                    if bestScore == nil or score > bestScore then
                        best, bestScore = point, score
                    end
                end
            end
        end
    end
    return best
end

