-- Per-mode finishers
-- ====================================================================

local function swordPass()
    if not Config.doSword then return end
    if not equipSword() then
        Finisher.note = "no arena sword yet"
        return
    end
    local target, distance = nearestPlayer(Config.swordRange, true)
    if not target then
        Finisher.note = "no target in range"
        return
    end
    local _, _, root = characterInfo()
    if root then
        root.CFrame = CFrame.lookAt(
            root.Position,
            Vector3.new(target.root.Position.X, root.Position.Y, target.root.Position.Z))
    end
    swing()
    Finisher.note = ("swinging at %s (%.0f studs)"):format(target.player.Name, distance or 0)
end

local function hideSeekPass(state)
    if not Config.doHideSeek then return end
    local role  = LocalPlayer:GetAttribute("ForestHideSeekRole")
    local phase = tostring(state.hideSeekPhase or "")
    if state.hiding == true then
        phase = "Hiding"
    elseif state.hiding == false and phase == "" then
        phase = "Seeking"
    end
    if role == "Ghost" then
        Finisher.note = "ghost - spectating"
        return
    end
    if role == "Seeker" then
        local target, distance = nearestPlayer(1e4, true)
        if target then
            walkTo(target.root.Position, 3)
            if distance and distance <= math.max(8, Config.swordRange) then
                equipSword()
                swing()
            end
            Finisher.note = ("seeking %s (%.0f studs)"):format(target.player.Name, distance or 0)
        else
            Finisher.note = "no hiders visible"
        end
        return
    end
    if phase == "Seeking" then
        local seeker = nearestPlayer(1e4, true)
        local _, _, root = characterInfo()
        if seeker and root and (seeker.root.Position - root.Position).Magnitude < 22 then
            local spot = findHidingSpot()
            if spot then
                World.hideSpot   = spot
                World.hideSpotAt = os.clock()
                walkTo(spot, 3)
                Finisher.note = "seeker close - relocating"
                return
            end
        end
        stopMoving()
        Finisher.note = "staying hidden"
        return
    end
    local spot = World.hideSpot
    if not spot or (os.clock() - World.hideSpotAt) > 15 then
        spot = findHidingSpot()
        World.hideSpot   = spot
        World.hideSpotAt = os.clock()
    end
    if not spot then
        Finisher.note = "no hiding spot found"
        return
    end
    if arrived(spot, 7) then
        stopMoving()
        Finisher.note = "in hiding spot"
    else
        walkTo(spot, 3)
        Finisher.note = "moving to hiding spot"
    end
end

local function colourPass(state)
    if not Config.doColour then return end
    local pick, danger = colourDanger(state)
    if pick and pick ~= World.lastColourPick then
        World.lastColourPick = pick
        World.colourPickAt   = os.clock()
        log("colour pick: " .. COLOR_ORDER[pick].name)
    end
    if danger and not World.colourDangerAt then
        World.colourDangerAt = os.clock()
        log("colour drop incoming")
    elseif not danger then
        World.colourDangerAt = nil
    end
    local pads = refreshPads()
    local _, _, root = characterInfo()
    if not root then return end
    local onPad
    for index, position in pairs(pads) do
        if (Vector3.new(position.X, root.Position.Y, position.Z) - root.Position).Magnitude < 12 then
            onPad = index
            break
        end
    end
    local mustMove = danger and onPad ~= nil and (pick == nil or onPad == pick)
    if mustMove or (World.lastColourPick
        and (os.clock() - World.colourPickAt) < 4
        and onPad == World.lastColourPick) then
        local avoid = pick or World.lastColourPick or onPad
        local best, bestDistance
        for index, position in pairs(pads) do
            if index ~= avoid and index ~= onPad then
                local distance = (position - root.Position).Magnitude
                if bestDistance == nil or distance < bestDistance then
                    best, bestDistance = position, distance
                end
            end
        end
        if best then
            walkTo(best, 2)
            Finisher.note = "leaving " .. (COLOR_ORDER[avoid] and COLOR_ORDER[avoid].name or "the pad")
            return
        end
    end
    if onPad then
        stopMoving()
        Finisher.note = "standing on " .. COLOR_ORDER[onPad].name
        return
    end
    local best, bestScore
    for index, position in pairs(pads) do
        local score = -((position - root.Position).Magnitude * 0.05)
        if index == World.lastColourPick then score = score - 100 end
        if bestScore == nil or score > bestScore then
            best, bestScore = position, score
        end
    end
    if best then
        walkTo(best, 3)
        Finisher.note = "moving to a colour pad"
    else
        Finisher.note = "no colour pads nearby"
    end
end

local function simonPass(state)
    if not Config.doSimon then return end
    if state.playersFrozen == true then
        stopMoving()
        Finisher.note = "players frozen"
        return
    end
    local command, says = readSimon(state)
    if command ~= World.lastCommand or says ~= World.lastSays then
        World.lastCommand = command
        World.lastSays    = says
        if command then
            log(("simon: %s (says=%s)"):format(command, tostring(says)))
        end
    end
    if not command then
        stopMoving()
        Finisher.note = "waiting for a command"
        return
    end
    if says == false then
        stopMoving()
        Finisher.note = "trick command ignored (" .. command .. ")"
        return
    end
    if command == "Jump" then
        jump()
        Finisher.note = "jumping"
        return
    end
    if command == "Freeze" then
        stopMoving()
        Finisher.note = "frozen"
        return
    end
    local pads = refreshPads()
    local index
    for i, entry in ipairs(COLOR_ORDER) do
        if string.lower(entry.name) == string.lower(command) then
            index = i
        end
    end
    local position = index and pads[index]
    if position then
        if arrived(position, 10) then
            stopMoving()
            Finisher.note = "on " .. command
        else
            walkTo(position, 3)
            Finisher.note = "moving to " .. command
        end
    else
        Finisher.note = "no pad for " .. command
    end
end

local function redGreenPass(state)
    if not Config.doRedGreen then return end
    if state.playersFrozen == true then
        stopMoving()
        Finisher.note = "players frozen"
        return
    end
    local light = readLight(state)
    if light then
        World.light   = light
        World.lightAt = os.clock()
    end
    if World.light == "red" then
        stopMoving()
        Finisher.note = "red light - standing still"
        return
    end
    if World.light == "green" then
        local target = Config.followPack and packCenter(400) or nil
        if target then
            walkTo(target, 2)
            Finisher.note = "green light - advancing"
        else
            jump()
            Finisher.note = "green light - no pack to follow"
        end
        return
    end
    stopMoving()
    Finisher.note = "waiting for the light"
end

local function lastToLeavePass()
    if not Config.doLastToLeave then return end
    stopMoving()
    Finisher.note = "holding position"
end

local function runFinisher()
    local state = State.current
    if not Config.finishEnabled or not state or state.phase == "Idle" then
        Finisher.status = "finisher off"
        return
    end
    if not inEvent() then
        Finisher.status = "not in an event"
        return
    end
    local phase = tostring(state.phase)
    if phase == "Finished" or phase == "Settling" then
        Finisher.status = "event over"
        return
    end
    if state.paused == true or state.intermission == true or state.waitingForPlayer == true then
        Finisher.status = "paused"
        return
    end
    local kind = tostring(state.kind)
    Finisher.status = ("%s / %s"):format(KIND_LABELS[kind] or kind, phase)

    if kind == "SwordFight" then
        if phase == "Running" then swordPass() end
    elseif kind == "HideAndSeek" then
        hideSeekPass(state)
    elseif kind == "ColorElimination" then
        if phase == "Running" then colourPass(state) end
    elseif kind == "SimonSays" then
        if phase == "Running" then simonPass(state) end
    elseif kind == "RedLightGreenLight" then
        if phase == "Running" then redGreenPass(state) end
    elseif kind == "LastToLeave" then
        if phase == "Running" then lastToLeavePass() end
    else
        Finisher.note = "no automation for " .. kind
    end
end

-- ====================================================================
-- Poll (state refresh only — no joiner, no teleport)
-- ====================================================================

local function pollOnce()
    invoke("Get", {})
end

-- ====================================================================
-- Drivers
-- ====================================================================

local connections = {}
local accumulators = { finisher = 0 }

local function startDriver()
    if connections.heartbeat then return end

    if eventUpdate then
        connections.update = eventUpdate.OnClientEvent:Connect(function(payload)
            if type(payload) ~= "table" then return end
            if payload.phase == "Eliminated" then
                log("eliminated: " .. tostring(payload.reason))
                return
            end
            applyState(payload)
        end)
    end

    connections.character = LocalPlayer.CharacterAdded:Connect(function()
        Move.target      = nil
        World.hideSpot   = nil
        World.hideSpotAt = 0
    end)

    connections.heartbeat = RunService.Heartbeat:Connect(function(delta)
        accumulators.finisher = accumulators.finisher + delta
        if accumulators.finisher < Config.tick then return end
        accumulators.finisher = 0

        -- Anti-fall platform — only during Colour Elimination.
        local cstate = State.current
        if Config.antiFall
           and cstate
           and inEvent()
           and tostring(cstate.kind)  == "ColorElimination"
           and tostring(cstate.phase) == "Running" then
            local okP = pcall(updatePlatform)
            if not okP then destroyPlatform() end
        else
            destroyPlatform()
        end

        if (os.clock() - State.lastPollAt) >= Config.pollInterval then
            State.lastPollAt = os.clock()
            local ok, err = pcall(pollOnce)
            if not ok then State.lastError = tostring(err) end
        end

        local ok, err = pcall(runFinisher)
        if not ok then State.lastError = tostring(err) end
    end)
end

local function stopDriver()
    for key, conn in pairs(connections) do
        if conn then pcall(function() conn:Disconnect() end) end
        connections[key] = nil
    end
    stopMoving()
    destroyPlatform()
end

-- ====================================================================
-- Public API
-- ====================================================================

local Module = {}
Module.Config  = Config
Module.State   = State
Module.World   = World
Module.Finisher = Finisher

function Module:Start()
    startDriver()
    pcall(pollOnce)
    return self
end

function Module:Stop()
    stopDriver()
    return self
end

function Module:Leave()
    if inEvent() then
        local reply = invoke("Leave", { id = State.current.id })
        World.invalidate()
        return reply
    end
    return nil
end

function Module:IsRunning()
    return connections.heartbeat ~= nil
end

function Module:InEvent()
    return inEvent()
end

function Module:CurrentState()
    return State.current
end

function Module:Describe()
    local state = State.current or {}
    return ("kind=%s phase=%s id=%s note=%s")
        :format(tostring(state.kind), tostring(state.phase),
                tostring(state.id and state.id:sub(1, 8)), Finisher.note)
end

-- Optional: expose internal helpers if your hub wants them.
Module._internal = {
    invoke          = invoke,
    characterInfo   = characterInfo,
    walkTo          = walkTo,
    stopMoving      = stopMoving,
    nearestPlayer   = nearestPlayer,
    refreshPads     = refreshPads,
    COLOR_ORDER     = COLOR_ORDER,
    readSimon       = readSimon,
    readColourPick  = readColourPick,
    readLight       = readLight,
    updatePlatform  = updatePlatform,
    destroyPlatform = destroyPlatform,
}

return Module
