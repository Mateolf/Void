-- TAB 9 — COMBAT
---------------------------------------------------------------------------
do
    local combatTab = HUB.createTab("combat", "Combat")

    local Combat = {
        AutoTarget     = false,
        AutoFire       = false,
        AutoEquip      = true,
        AutoApproach   = true,
        ShowIndicator  = true,
        TeamCheck      = true,
        MaxDistance    = 250,
        MeleeRange     = 8,
        AimSmoothness  = 0.2,
        FireRate       = 0.10,
        TargetPart     = "HumanoidRootPart",
        Target         = nil,
        Indicator      = nil,
        DetectedTools  = {},
        PreferredTool  = nil,
        PreferredKind  = nil,
    }
    ENV.__VoidHub_Combat = Combat

    local SLAP_KW = {
        "glove","slap","punch","fist","hand","palm","knuckle","gauntlet",
        "boxing","karate",
    }
    local MELEE_KW = {
        "sword","blade","katana","knife","dagger","axe","hatchet","bat",
        "mace","hammer","spear","lance","scythe","club","wrench","crowbar",
        "pickaxe","sai","rapier","cutlass","scimitar","staff","trident",
        "halberd","nunchuck","flail","shovel","pitchfork",
    }
    local RANGED_KW = {
        "gun","blaster","beam","laser","rifle","pistol","shotgun","sniper",
        "bow","arrow","ray","cannon","launcher","rail","minigun","smg","uzi",
        "deagle","revolver","carbine","musket","crossbow","railgun","plasma",
        "photon","arc","sling","throw",
    }
    local MAGIC_KW = {
        "magic","spell","orb","fireball","ice","freeze","lightning","bolt",
        "hex","curse","rune","charm","tome","grimoire","summon",
    }
    local KIND_COLORS = {
        slap    = Color3.fromRGB(255, 200, 100),
        melee   = Color3.fromRGB(200, 130, 80),
        ranged  = Color3.fromRGB(100, 180, 255),
        magic   = Color3.fromRGB(180, 100, 255),
        unknown = Color3.fromRGB(150, 150, 150),
    }

    local function matchAny(name, kws)
        local n = name:lower()
        for _, kw in ipairs(kws) do
            if n:find(kw, 1, true) then return true end
        end
        return false
    end

    local function classifyTool(tool)
        if not tool or not tool:IsA("Tool") then return "unknown" end
        if matchAny(tool.Name, SLAP_KW)   then return "slap"   end
        if matchAny(tool.Name, MELEE_KW)  then return "melee"  end
        if matchAny(tool.Name, RANGED_KW) then return "ranged" end
        if matchAny(tool.Name, MAGIC_KW)  then return "magic"  end
        local hasHandle, hasRemote = false, false
        for _, d in ipairs(tool:GetDescendants()) do
            if d:IsA("BasePart") and d.Name:lower():find("handle", 1, true) then
                hasHandle = true
            elseif d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
                hasRemote = true
            end
        end
        if hasHandle and not hasRemote then return "melee" end
        if hasRemote and not hasHandle then return "ranged" end
        if hasHandle then return "melee" end
        return "unknown"
    end

    local function listPlayerTools()
        local out = {}
        local char = LocalPlayer.Character
        local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
        if char then
            for _, c in ipairs(char:GetChildren()) do
                if c:IsA("Tool") then
                    out[#out+1] = { tool=c, equipped=true, kind=classifyTool(c) }
                end
            end
        end
        if bp then
            for _, c in ipairs(bp:GetChildren()) do
                if c:IsA("Tool") then
                    out[#out+1] = { tool=c, equipped=false, kind=classifyTool(c) }
                end
            end
        end
        return out
    end

    local function getHRP(plr)
        local c = plr.Character
        return c and c:FindFirstChild("HumanoidRootPart"),
               c and c:FindFirstChildOfClass("Humanoid")
    end
    local function getLocalHRP()
        local c = LocalPlayer.Character
        return c and c:FindFirstChild("HumanoidRootPart")
    end
    local function isEnemy(plr)
        if plr == LocalPlayer or not plr.Character then return false end
        local hrp, hum = getHRP(plr)
        if not hrp or not hum or hum.Health <= 0 then return false end
        if Combat.TeamCheck and LocalPlayer.Team and plr.Team == LocalPlayer.Team then
            return false
        end
        return true
    end
    local function findNearestTarget()
        local my = getLocalHRP(); if not my then return nil end
        local best, bd = nil, Combat.MaxDistance
        for _, p in ipairs(Players:GetPlayers()) do
            if isEnemy(p) then
                local hrp = getHRP(p)
                if hrp then
                    local d = (my.Position - hrp.Position).Magnitude
                    if d < bd then best, bd = p, d end
                end
            end
        end
        return best
    end

    local function ensureIndicator(plr)
        if not Combat.ShowIndicator then return end
        if not plr or not plr.Character then return end
        local head = plr.Character:FindFirstChild("Head")
        if not head then return end
        if Combat.Indicator and Combat.Indicator.Parent
           and Combat.Indicator.Adornee == head then return end
        if Combat.Indicator then
            pcall(function() Combat.Indicator:Destroy() end)
            Combat.Indicator = nil
        end
        local bg = Instance.new("BillboardGui")
        bg.Name = "__VoidHub_CombatIndicator"
        bg.Adornee = head
        bg.Size = UDim2.fromOffset(140, 26)
        bg.StudsOffset = Vector3.new(0, 3.2, 0)
        bg.AlwaysOnTop = true
        bg.Parent = plr.Character
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.fromScale(1, 1)
        lbl.BackgroundTransparency = 1
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 15
        lbl.TextColor3 = Color3.fromRGB(255, 80, 80)
        lbl.TextStrokeTransparency = 0
        lbl.Text = "[ TARGET ]"
        lbl.Parent = bg
        Combat.Indicator = bg
    end
    local function clearIndicator()
        if Combat.Indicator then
            pcall(function() Combat.Indicator:Destroy() end)
            Combat.Indicator = nil
        end
    end

    local function getActiveTool()
        local char = LocalPlayer.Character
        local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
        if Combat.PreferredTool then
            if char then
                local t = char:FindFirstChild(Combat.PreferredTool)
                if t and t:IsA("Tool") then return t, classifyTool(t) end
            end
            if bp then
                local t = bp:FindFirstChild(Combat.PreferredTool)
                if t and t:IsA("Tool") then return t, classifyTool(t) end
            end
        end
        if char then
            for _, c in ipairs(char:GetChildren()) do
                if c:IsA("Tool") then return c, classifyTool(c) end
            end
        end
        if bp then
            for _, c in ipairs(bp:GetChildren()) do
                if c:IsA("Tool") then return c, classifyTool(c) end
            end
        end
        return nil, nil
    end

    local function equipTool(tool)
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum or not tool then return end
        pcall(function() hum:EquipTool(tool) end)
        if tool.Parent ~= char then
            pcall(function() tool.Parent = char end)
        end
    end

    local function fireTool(tool)
        if not tool then return end
        pcall(function() tool:Activate() end)
        for _, d in ipairs(tool:GetDescendants()) do
            if d:IsA("RemoteEvent") then
                pcall(function() d:FireServer() end)
            elseif d:IsA("RemoteFunction") then
                pcall(function() d:InvokeServer() end)
            end
        end
        pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton1(Vector2.new(0, 0))
        end)
    end

    local function aimAt(plr)
        if not plr or not plr.Character then return end
        local cam = workspace.CurrentCamera
        if not cam then return end
        local part
        if Combat.TargetPart == "Head" then
            part = plr.Character:FindFirstChild("Head")
        else
            part = plr.Character:FindFirstChild("HumanoidRootPart")
        end
        if not part then return end
        pcall(function()
            local look = CFrame.new(cam.CFrame.Position, part.Position)
            cam.CFrame = cam.CFrame:Lerp(look, Combat.AimSmoothness)
        end)
    end

    local fireAccum = 0
    local lastEquipAttempt = 0

    bind(RunService.Heartbeat, function(dt)
        if HUB.__saving then return end
        if not (Combat.AutoTarget or Combat.AutoFire) then
            if Combat.Indicator then clearIndicator() end
            Combat.Target = nil
            return
        end

        local cur = Combat.Target
        local invalid = false
        if cur then
            if not cur.Parent or not cur.Character then invalid = true
            else
                local hrp, hum = getHRP(cur)
                local my = getLocalHRP()
                if not hrp or not hum or hum.Health <= 0 then invalid = true
                elseif my and (my.Position - hrp.Position).Magnitude > Combat.MaxDistance then
                    invalid = true
                end
            end
        end
        if not cur or invalid then
            Combat.Target = findNearestTarget()
        end
        local target = Combat.Target
        if not target then
            clearIndicator()
            return
        end

        local tool, kind = getActiveTool()

        if Combat.AutoEquip and tool and tool.Parent ~= LocalPlayer.Character then
            if tick() - lastEquipAttempt > 1 then
                lastEquipAttempt = tick()
                equipTool(tool)
            end
        end

        if Combat.AutoTarget then
            ensureIndicator(target)
            aimAt(target)
        else
            clearIndicator()
        end

        if Combat.AutoApproach and (kind == "melee" or kind == "slap") then
            local my = getLocalHRP()
            local thrp = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
            if my and thrp then
                local d = (my.Position - thrp.Position).Magnitude
                if d > Combat.MeleeRange then
                    pcall(function()
                        my.CFrame = CFrame.new(thrp.Position + Vector3.new(0, 3, 0))
                    end)
                end
            end
        end

        if Combat.AutoFire and tool then
            fireAccum = fireAccum + dt
            local jitter = Combat.FireRate * (0.85 + math.random() * 0.3)
            if fireAccum >= jitter then
                fireAccum = 0
                fireTool(tool)
            end
        end
    end)

