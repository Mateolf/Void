        new("UIPadding", { Parent = page, PaddingTop = UDim.new(0, 12),
            PaddingBottom = UDim.new(0, 12), PaddingLeft = UDim.new(0, 12),
            PaddingRight = UDim.new(0, 12) })

        local tab = { id = id, label = label, btn = btn, lbl = lbl,
            page = page, active = false }

        tab.select = function()
            for _, t in pairs(Tabs) do
                t.active = false
                t.page.Visible = false
                t.lbl.TextColor3 = Theme.SubText
                t.btn.BackgroundTransparency = 1
            end
            tab.active = true
            tab.page.Visible = true
            tab.lbl.TextColor3 = Theme.Accent
            tab.btn.BackgroundTransparency = 0.88
        end

        Tabs[id] = tab

        local function hover(state)
            if tab.active then return end
            TweenService:Create(lbl, TweenInfo.new(0.12), {
                TextColor3 = state and Theme.Text or Theme.SubText }):Play()
            TweenService:Create(btn, TweenInfo.new(0.12), {
                BackgroundTransparency = state and 0.75 or 1 }):Play()
        end
        bind(btn.MouseEnter, function() hover(true) end)
        bind(btn.MouseLeave, function() hover(false) end)
        bind(btn.MouseButton1Click, function() tab.select() end)

        return tab
    end

    local function selectTab(id)
        local t = Tabs[id]
        if t and t.select then t.select() end
    end

