-- ====================================================================
-- State readers (command-driven modes)
-- ====================================================================

local function canonicalSimonWord(text)
    local lower = string.lower(tostring(text))
    for _, word in ipairs(SIMON_WORDS) do
        if string.find(lower, string.lower(word), 1, true) then
            return word
        end
    end
    return nil
end

local function readSimon(state)
    local command, says
    for _, key in ipairs(SIMON_COMMAND_KEYS) do
        local value = state[key]
        if type(value) == "string" then
            local word = canonicalSimonWord(value)
            if word then
                command = word
                says = string.find(string.lower(value), "simon says", 1, true) ~= nil
                break
            end
        end
    end
    for key, value in pairs(state) do
        local lower = string.lower(tostring(key))
        if type(value) == "boolean"
            and (string.find(lower, "say", 1, true)
                or string.find(lower, "truth", 1, true)
                or string.find(lower, "real", 1, true)) then
            says = value
        end
    end
    if command and state.simonActiveInstruction == false then
        command = nil
    end
    return command, says
end

local function colourIndexFromValue(value)
    if type(value) == "number" and value >= 1 and value <= #COLOR_ORDER then
        return math.floor(value)
    end
    if type(value) == "string" then
        local upper = string.upper(value)
        for index, entry in ipairs(COLOR_ORDER) do
            if string.find(upper, entry.name, 1, true) then
                return index
            end
        end
    end
    if type(value) == "table" then
        for _, item in pairs(value) do
            local index = colourIndexFromValue(item)
            if index then return index end
        end
    end
    return nil
end

local function readColourPick(state)
    for _, key in ipairs(COLOUR_PICK_KEYS) do
        local index = colourIndexFromValue(state[key])
        if index then return index end
    end
    return nil
end

local function colourDanger(state)
    local pick = readColourPick(state)
    local danger = state.droppingSoon == true
        or state.choosing == true
        or state.revealed == true
    return pick, danger
end

local function readLight(state)
    if state.redLightRaceActive == true or tostring(state.kind) == "RedLightGreenLight" then
        if state.redLight == true  then return "red"   end
        if state.redLight == false then return "green" end
    end
    local text = string.lower(tostring(state.instruction or "") .. " " .. tostring(state.status or ""))
    local green = string.find(text, "green", 1, true) ~= nil
    local red   = string.find(text, "red",   1, true) ~= nil
    if green and not red then return "green" end
    if red and not green then return "red"   end
    return nil
end

