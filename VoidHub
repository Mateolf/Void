-- TAB 10 — ITEM FARM
---------------------------------------------------------------------------
do
    local itemFarmTab = HUB.createTab("itemfarm", "Item Farm")

    local ItemFarm = {
        Items             = {},
        Blacklist         = {},
        AutoCollecting    = false,
        TeleportDelay     = 0.15,
        MinScore          = 3,
        AutoClickPrompts  = true,
    }
    ENV.__VoidHub_ItemFarm = ItemFarm

    local STRONG_KW = {
        "orb","coin","gem","token","cash","money","star","diamond",
        "crystal","fruit","loot","reward","badge","chest","treasure",
        "jewel","sapphire","ruby","emerald","pearl","gold",
    }
    local MEDIUM_KW = {
        "key","candy","drop","xp","exp","pickup","pick","collect",
        "ingot","nugget","bone","shell","seed","berry","sweet","food",
    }
    local CONTAINER_KW = {
        "item","collectible","pickup","loot","drop","reward","currency",
        "money","coins","orbs","gems","treasure","stash","vault",
    }
    local JUNK = {
        spawnlocation = true, baseplate = true, camera = true,
        terrain = true, spawn = true, handle = true, torso = true,
        head = true, humanoidrootpart = true, humanoid = true,
    }

    local function matchKw(name, kws)
        local n = name:lower()
        for _, kw in ipairs(kws) do
            if n:find(kw, 1, true) then return true end
        end
        return false
    end

    local function scoreItem(inst)
        if not inst:IsA("BasePart") then return 0 end
        if ItemFarm.Blacklist[inst] then return 0 end
        local nm = inst.Name
        local nl = nm:lower()
        if JUNK[nl] then return 0 end

        local score = 0
        if matchKw(nm, STRONG_KW) then score += 3 end
        if matchKw(nm, MEDIUM_KW) then score += 2 end

        local p = inst.Parent
        if p then
            if matchKw(p.Name, CONTAINER_KW) then score += 2 end
        end

        for _, c in ipairs(inst:GetChildren()) do
            if c:IsA("PointLight") or c:IsA("ParticleEmitter")
               or c:IsA("Beam") or c:IsA("Highlight") then
                score += 1
                break
            end
        end
        for _, c in ipairs(inst:GetChildren()) do
            if c:IsA("ClickDetector") then score += 2 end
            if c:IsA("ProximityPrompt") then score += 3 end
        end

        local sz = inst.Size
        if sz.X * sz.Y * sz.Z < 100 then score += 1 end
        if inst.Anchored then score += 1 end

        return score
    end

    local function getLocalHRP()
        local c = LocalPlayer.Character
        return c and c:FindFirstChild("HumanoidRootPart")
    end

    local function scanWorkspace()
        ItemFarm.Items = {}
        local seen = {}
        pcall(function()
            for _, inst in ipairs(workspace:GetDescendants()) do
                if inst:IsA("BasePart") and not seen[inst] then
                    local s = scoreItem(inst)
                    if s >= ItemFarm.MinScore then
                        seen[inst] = true
                        ItemFarm.Items[#ItemFarm.Items + 1] = { inst = inst, score = s }
                    end
                end
            end
        end)
        table.sort(ItemFarm.Items, function(a, b) return a.score > b.score end)
    end

    local function tryInteract(inst)
        for _, c in ipairs(inst:GetChildren()) do
            if c:IsA("ClickDetector") then
                pcall(function()
                    if type(fireclickdetector) == "function" then
                        fireclickdetector(c)
                    end
                end)
            elseif c:IsA("ProximityPrompt") then
                pcall(function()
                    if type(fireproximityprompt) == "function" then
                        fireproximityprompt(c)
                    else
                        c:InputHoldBegin()
                        task.wait(math.max(0.05, c.HoldDuration or 0.1))
                        c:InputHoldEnd()
                    end
                end)
            end
        end
    end

    local listFrame, statusLbl, collectStatusLbl

    local function makeItemRow(inst, score)
        local row = new("Frame", { Parent = listFrame,
            Size = UDim2.new(1, 0, 0, isMobile and 38 or 32),
            BackgroundColor3 = HUB.Theme.SurfaceAlt, BorderSizePixel = 0 },
            { new("UICorner", { CornerRadius = UDim.new(0, 8) }) })
        new("UIStroke", { Parent = row, Thickness = 1, Color = HUB.Theme.Border,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Transparency = 0.4 })
        new("TextLabel", { Parent = row,
            Position = UDim2.new(0, 8, 0, 1), Size = UDim2.new(1, -110, 0, 16),
            BackgroundTransparency = 1, Font = HUB.Theme.Font,
            TextSize = isMobile and 12 or 11, TextColor3 = HUB.Theme.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Text = inst.Name })
        new("TextLabel", { Parent = row,
            Position = UDim2.new(0, 8, 0, 17), Size = UDim2.new(1, -110, 0, 13),
            BackgroundTransparency = 1, Font = HUB.Theme.Font,
            TextSize = isMobile and 10 or 9, TextColor3 = HUB.Theme.SubText,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Text = ("score %d  •  %s"):format(score, inst:GetFullName()) })
        local tpBtn = new("TextButton", { Parent = row,
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -8, 0.5, 0),
            Size = UDim2.fromOffset(50, 22),
            BackgroundColor3 = HUB.Theme.Accent,
            Font = HUB.Theme.Font, TextSize = isMobile and 11 or 10,
            TextColor3 = Color3.new(1,1,1), Text = "TP",
            AutoButtonColor = false, BorderSizePixel = 0 },
            { new("UICorner", { CornerRadius = UDim.new(0, 6) }) })
        bind(tpBtn.MouseButton1Click, function()
            local hrp = getLocalHRP()
            if not hrp then HUB.setStatus("No character.", "error"); return end
            if not inst or not inst.Parent then
                HUB.setStatus("Item gone.", "error"); return
            end
            pcall(function()
                hrp.CFrame = CFrame.new(inst.Position + Vector3.new(0, 3, 0))
            end)
            tryInteract(inst)
            HUB.setStatus("Teleported to " .. inst.Name, "success")
        end)
        local rmBtn = new("TextButton", { Parent = row,
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -62, 0.5, 0),
            Size = UDim2.fromOffset(22, 22),
            BackgroundColor3 = Color3.fromRGB(80, 40, 40),
            Font = HUB.Theme.Font, TextSize = isMobile and 12 or 11,
            TextColor3 = Color3.fromRGB(255, 200, 200), Text = "✕",
            AutoButtonColor = false, BorderSizePixel = 0 },
            { new("UICorner", { CornerRadius = UDim.new(0, 6) }) })
        bind(rmBtn.MouseButton1Click, function()
            ItemFarm.Blacklist[inst] = true
            for i, e in ipairs(ItemFarm.Items) do
                if e.inst == inst then table.remove(ItemFarm.Items, i); break end
            end
            refreshList()
        end)
    end

    local function refreshList()
        for _, c in ipairs(listFrame:GetChildren()) do
            if c:IsA("Frame") then c:Destroy() end
        end
        for _, e in ipairs(ItemFarm.Items) do
            if e.inst and e.inst.Parent then
                makeItemRow(e.inst, e.score)
            end
        end
        if #ItemFarm.Items == 0 then
            new("TextLabel", { Parent = listFrame,
                Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1,
                Font = HUB.Theme.Font, TextSize = 11,
                TextColor3 = HUB.Theme.SubText,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = "  (none found — try lowering the Min Score)" })
        end
        if statusLbl then
            statusLbl.Text = ("Found %d item(s)."):format(#ItemFarm.Items)
        end
    end

    local function doAutoCollect()
        if ItemFarm.AutoCollecting then
            HUB.setStatus("Auto-collect already running.", "error"); return
        end
        scanWorkspace()
        refreshList()
        if #ItemFarm.Items == 0 then
            HUB.setStatus("Auto-collect: nothing found.", "error"); return
        end
        ItemFarm.AutoCollecting = true
        HUB.setStatus("Auto-collect started.", "success")
        task.spawn(function()
            local ok, err = pcall(function()
                for i, e in ipairs(ItemFarm.Items) do
                    if not ItemFarm.AutoCollecting then break end
                    local inst = e.inst
                    if inst and inst.Parent then
                        local hrp = getLocalHRP()
                        if hrp then
                            pcall(function()
                                hrp.CFrame = CFrame.new(inst.Position + Vector3.new(0, 3, 0))
                            end)
                            if ItemFarm.AutoClickPrompts then
                                tryInteract(inst)
                            end
                            if collectStatusLbl then
                                collectStatusLbl.Text = ("Auto-collect: %d / %d")
                                    :format(i, #ItemFarm.Items)
                            end
                        end
                    end
                    task.wait(ItemFarm.TeleportDelay)
                end
            end)
            ItemFarm.AutoCollecting = false
            if collectStatusLbl then collectStatusLbl.Text = "Auto-collect: idle" end
            if ok then HUB.setStatus("Auto-collect complete.", "success")
            else HUB.setStatus("Auto-collect error: " .. tostring(err), "error") end
        end)
    end

    HUB.sectionHeader(itemFarmTab.page, "Scanner")
    statusLbl = new("TextLabel", { Parent = itemFarmTab.page,
        LayoutOrder = HUB.nOrder(), Size = UDim2.new(1, 0, 0, 20),
        BackgroundTransparency = 1, Font = HUB.Theme.Font,
        TextSize = isMobile and 11 or 10, TextColor3 = HUB.Theme.SubText,
        TextXAlignment = Enum.TextXAlignment.Left, Text = "Not scanned yet." })
    new("TextLabel", { Parent = itemFarmTab.page,
        LayoutOrder = HUB.nOrder(), Size = UDim2.new(1, 0, 0, 36),
        BackgroundTransparency = 1, Font = HUB.Theme.Font,
        TextSize = isMobile and 10 or 9, TextColor3 = HUB.Theme.SubText,
        TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true,
        Text = "Scores every BasePart in the workspace: name keywords " ..
               "(orb/coin/gem/token/cash/…), parent folder, PointLights, " ..
               "ClickDetectors, ProximityPrompts, small size, anchoring. " ..
