        local swatch = new("Frame", { Parent = row,
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(48, 20),
            BackgroundColor3 = Theme[key] or Color3.new(1, 1, 1),
            BorderSizePixel = 0 },
            { new("UICorner", { CornerRadius = UDim.new(0, 6) }) })
        new("UIStroke", { Parent = swatch, Thickness = 1, Color = Theme.Border,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Transparency = 0.2 })
        bindTheme(swatch, "BackgroundColor3", key)
        local colorBox = new("Frame", { Parent = parent, Visible = false,
            LayoutOrder = nOrder(), Size = UDim2.new(1, 0, 0, 100),
            BackgroundColor3 = Theme.Surface, BorderSizePixel = 0 },
            { new("UICorner", { CornerRadius = UDim.new(0, 12) }) })
        bindTheme(colorBox, "BackgroundColor3", "Surface")
        new("UIListLayout", { Parent = colorBox, Padding = UDim.new(0, 4) })
        new("UIPadding", { Parent = colorBox, PaddingTop = UDim.new(0, 6),
            PaddingBottom = UDim.new(0, 6), PaddingLeft = UDim.new(0, 8),
            PaddingRight = UDim.new(0, 8) })
        for _, ch in ipairs({"R", "G", "B"}) do
            local c = Theme[key] or Color3.new(1, 1, 1)
            local cur = (ch == "R" and c.R) or (ch == "G" and c.G) or c.B
            makeSlider(colorBox, ch, 0, 1, cur, function(v)
                local cc = Theme[key] or Color3.new(1, 1, 1)
                if ch == "R" then cc = Color3.new(v, cc.G, cc.B)
                elseif ch == "G" then cc = Color3.new(cc.R, v, cc.B)
                else cc = Color3.new(cc.R, cc.G, v) end
                Theme[key] = cc
                applyTheme()
            end)
        end
        bind(swatch.InputBegan, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                colorBox.Visible = not colorBox.Visible
            end
        end)
        return colorBox
    end

