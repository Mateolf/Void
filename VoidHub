-- ====================================================================

local function colorIndexForPart(part)
    local name = string.upper(part.Name)
    for index, entry in ipairs(COLOR_ORDER) do
        if string.find(name, entry.name, 1, true) then
            return index
        end
    end
    local color = part.Color
    for index, entry in ipairs(COLOR_ORDER) do
        local target = entry.color
        if math.abs(color.R - target.R) < 0.06
            and math.abs(color.G - target.G) < 0.06
            and math.abs(color.B - target.B) < 0.06 then
            return index
        end
    end
    return nil
end

local function findColorPads(radius)
    refreshOverlapFilter()
    local _, _, root = characterInfo()
    if not root then return {} end
    local parts = workspace:GetPartBoundsInRadius(root.Position, radius or 150, overlapParams)
    local sums, counts = {}, {}
    for _, part in ipairs(parts) do
        local index = colorIndexForPart(part)
        if index then
            sums[index]   = (sums[index] or Vector3.zero) + part.Position
            counts[index] = (counts[index] or 0) + 1
        end
    end
    local pads = {}
    for index, count in pairs(counts) do
        pads[index] = sums[index] / count
    end
    return pads
end

local function refreshPads()
    if (os.clock() - World.padsAt) > 4 then
        World.pads   = findColorPads(150)
        World.padsAt = os.clock()
    end
    return World.pads
end

