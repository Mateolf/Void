    HUB.sectionHeader(playerTab.page, "Stealth")
    HUB.makeToggle(playerTab.page, "Invisible (localside)", false, function(v)
        PlayerState.Invisible = v
        HUB.setStatus("Invisible " .. (v and "on" or "off") .. ".")
    end)
    local invisAccum = 0
    bind(RunService.Stepped, function(_, dt)
        if HUB.__saving then return end
        invisAccum += dt
        if invisAccum < 0.15 then return end
        invisAccum = 0
        local char = getChar()
        if not char then return end
        for _, inst in ipairs(char:GetDescendants()) do
            if inst:IsA("BasePart") then
                inst.LocalTransparencyModifier = PlayerState.Invisible and 1 or 0
            elseif inst:IsA("Decal") then
                inst.Transparency = PlayerState.Invisible and 1 or 0
            end
        end
    end)

    HUB.sectionHeader(playerTab.page, "Teleport")
    HUB.makeButton(playerTab.page, "Click TP (tap a spot)", function()
        HUB.setStatus("Tap a spot in the world to teleport there...")
        local mouse = LocalPlayer:GetMouse()
        local conn
        conn = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                local hrp = getHRP()
                if hrp and mouse.Hit then
                    hrp.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0))
                    HUB.setStatus("Teleported.", "success")
                end
                conn:Disconnect()
            end
        end)
    end)
    HUB.makeButton(playerTab.page, "TP to Nearest Player", function()
        local hrp = getHRP()
        if not hrp then return end
        local closest, closestDist
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local theirHrp = plr.Character:FindFirstChild("HumanoidRootPart")
                if theirHrp then
                    local d = (hrp.Position - theirHrp.Position).Magnitude
                    if not closestDist or d < closestDist then
                        closest, closestDist = theirHrp, d
                    end
                end
            end
        end
        if closest then
            hrp.CFrame = closest.CFrame + Vector3.new(0, 3, 0)
            HUB.setStatus("Teleported to nearest player.", "success")
        else
            HUB.setStatus("No other players found.", "error")
        end
    end)

    HUB.sectionHeader(playerTab.page, "Misc")
    HUB.makeToggle(playerTab.page, "Anti-AFK", false, function(v)
        PlayerState.AntiAfk = v
        HUB.setStatus("Anti-AFK " .. (v and "on" or "off") .. ".")
    end)
    bind(LocalPlayer.Idled, function()
        if not PlayerState.AntiAfk then return end
        pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new())
        end)
    end)

    HUB.sectionHeader(playerTab.page, "Server / Info")
    HUB.makeButton(playerTab.page, "Rejoin Server", function()
        pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
        end)
    end)
    HUB.makeButton(playerTab.page, "Copy Job ID", function()
        if type(setclipboard) == "function" then
            pcall(setclipboard, tostring(game.JobId))
            HUB.setStatus("Job ID copied.", "success")
        end
    end)
    HUB.makeButton(playerTab.page, "Copy Place ID", function()
        if type(setclipboard) == "function" then
            pcall(setclipboard, tostring(game.PlaceId))
            HUB.setStatus("Place ID copied.", "success")
        end
    end)
    HUB.makeButton(playerTab.page, "Server Hop", function()
        task.spawn(function()
            local ok, err = pcall(function()
                local url = string.format(
                    "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100",
                    game.PlaceId)
                local res = HttpService:JSONDecode(game:HttpGet(url))
                if not res.data or #res.data == 0 then error("no servers found") end
                local list = {}
                for _, srv in ipairs(res.data) do
                    if srv.playing < srv.maxPlayers and srv.id ~= game.JobId then
                        list[#list + 1] = srv.id
                    end
                end
                if #list == 0 then error("no joinable servers") end
                TeleportService:TeleportToPlaceInstance(
                    game.PlaceId, list[math.random(1, #list)], LocalPlayer)
            end)
            if not ok then HUB.setStatus("Server hop failed: " .. tostring(err), "error")
            else HUB.setStatus("Joining new server...", "success") end
        end)
    end)

    bind(LocalPlayer.CharacterAdded, function()
        task.wait(1.5)
        local hum = getHum()
        if hum then
            if PlayerState.SpeedOverride.enabled then
                hum.WalkSpeed = PlayerState.SpeedOverride.value
            end
            if PlayerState.JumpOverride.enabled then
                pcall(function()
                    hum.UseJumpPower = true
                    hum.JumpPower = PlayerState.JumpOverride.value
                end)
            end
        end
        if PlayerState.Fly then stopFly() end
        if PlayerState.Swim then
            stopSwim()
            task.wait(0.4)
            if PlayerState.Swim then startSwim() end
        end
    end)
end

